SUPABASE_URL=###
SUPABASE_KEY=###
SUPABASE_DB_URL=###
SUPABASE_DB_PASSWORD=###
SUPABASE_DB_POOLER_HOST=aws-0-eu-west-1.pooler.supabase.com
OPERATIONAL_LOG_HASH_SECRET=
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_SAFETY_MODEL=openai/gpt-5.6-luna
OPENROUTER_SESSION_MODEL=openai/gpt-5.6-luna
# Poziom rozumowania odpowiedzi w rozmowie: minimal | low | medium | high | xhigh.
# Pusty = domyślny profil modelu. high/xhigh podnoszą też budżet tokenów i limit
# czasu jednej tury (30 s / 60 s zamiast 12 s) — trasa wiadomości i tak przycina
# go do pozostałego czasu sesji.
OPENROUTER_SESSION_REASONING_EFFORT=xhigh
OPENROUTER_SUMMARY_MODEL=openai/gpt-5.6-luna
OPENROUTER_TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe
# Dedykowany endpoint STT nie przyjmuje request-level ZDR. Produkcyjny klucz
# OpenRouter musi mieć wymuszony guardrail ZDR także dla transkrypcji.
# Opcjonalne nadpisanie publicznego adresu kontaktowego (domyślnie safespacenow123@gmail.com)
SUPPORT_EMAIL=
# Karty osób („Osoby z Twoich rozmów”): off | on. Wyłączone gasi ekstrakcję,
# sekcję na panelu i brief w prompcie; zapomnienie i usuwanie działają zawsze.
PEOPLE_MEMORY_MODE=off
# Soczewki tematyczne w rozmowie: off | on. Włączone uruchamia tani klasyfikator
# tematu obok bezpieczeństwa (fail-open) i dokleja do promptu moduł „co słyszeć
# i o co pytać” dla wykrytego tematu; etykieta jest lepka na sesję.
SESSION_LENS_MODE=off

# Stripe Managed Payments: domyślnie wyłączone, wyłącznie lokalny sandbox.
# Testowy Worker: skopiuj ustawienia do ignorowanego .dev.vars.billing,
# uzupełnij lokalnie i użyj npm run build, następnie npm run dev:billing.
BILLING_MODE=off
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
STRIPE_PRICE_ID=price_REPLACE
BILLING_APP_URL=http://127.0.0.1:4321
BILLING_DATABASE_URL=postgresql://safespace_billing_login:REPLACE_URL_ENCODED_PASSWORD@127.0.0.1:54322/postgres
