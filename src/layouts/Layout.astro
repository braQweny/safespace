---
import "../styles/global.css";
// Fonty są deklarowane w CSS (`global.css`), więc przeglądarka odkrywa je
// dopiero po pobraniu i sparsowaniu arkusza — stąd błysk zapasowego kroju i
// przesunięcie układu. Te cztery pliki (łacińskie i łacińskie rozszerzone,
// czyli polskie znaki) obsługują cały widoczny tekst; import `?url` daje ten
// sam zhashowany adres, do którego odwołuje się arkusz.
import newsreaderLatinUrl from "@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url";
import newsreaderLatinExtUrl from "@fontsource-variable/newsreader/files/newsreader-latin-ext-opsz-normal.woff2?url";
import sourceSansLatinUrl from "@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url";
import sourceSansLatinExtUrl from "@fontsource-variable/source-sans-3/files/source-sans-3-latin-ext-wght-normal.woff2?url";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";

const preloadedFontUrls = [sourceSansLatinUrl, sourceSansLatinExtUrl, newsreaderLatinUrl, newsreaderLatinExtUrl];

interface Props {
  title?: string;
  lang?: string;
  description?: string;
}

const {
  title = "SafeSpace",
  lang = "pl",
  description = "SafeSpace pomaga spokojnie przygotować się do pierwszej rozmowy w symulacji psychoterapeutycznej.",
} = Astro.props;

// Komunikaty o brakującej konfiguracji są przeznaczone dla osoby rozwijającej
// projekt (nazwy zmiennych środowiskowych) — nie mogą trafić do użytkownika.
const showConfigBanners = import.meta.env.DEV;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- Publiczny znacznik własności Google Search Console dla konta SafeSpace; wymagany do weryfikacji marki OAuth. -->
    <meta name="google-site-verification" content="ZDIJdGoSJCTZZNXsXuLsJ_eKO9kbVXBgb3WCKlEShpE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    {preloadedFontUrls.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <title>{title}</title>
    <script is:inline>
      /*
       * Motyw musi być ustawiony przed pierwszym malowaniem — inaczej osoba,
       * która wybrała wieczorny, dostaje w twarz błysk jasnego ekranu. Bez
       * zapisanego wyboru nie ustawiamy niczego i decyduje `prefers-color-scheme`,
       * więc telefon w trybie nocnym trafia na ciemną paletę także bez JS.
       */
      (() => {
        try {
          const stored = localStorage.getItem("safespace-theme");

          if (stored === "dark" || stored === "light") {
            document.documentElement.dataset.theme = stored;
          }
        } catch {
          // Prywatne okno albo zablokowane dane witryny — zostaje ustawienie systemu.
        }
      })();
    </script>
  </head>
  <body>
    {
      showConfigBanners &&
        missingConfigs.map((cfg) => (
          <Banner variant="error">
            <strong>Uwaga:</strong> {cfg.message}
            {cfg.docsUrl && (
              <>
                {" "}
                <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                  {cfg.docsLabel ?? "Dokumentacja"}
                </a>
                .
              </>
            )}
          </Banner>
        ))
    }
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
