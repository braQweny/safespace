---
import AppHeader from "@/components/AppHeader.astro";
import AvatarChoiceForm from "@/components/modality/AvatarChoiceForm";
import SiteFooter from "@/components/SiteFooter.astro";
import Layout from "@/layouts/Layout.astro";
import {
  AVATAR_CHOICE_ERROR_PARAM,
  getAvatarChoiceErrorMessage,
  parseAvatarChoiceErrorCode,
} from "@/lib/avatar-choice-errors";
import { MODALITY_CHOICES, type SelectedModalityAvatar } from "@/lib/modalities";
import { getAvatarPageCopy } from "@/lib/page-copy/avatar-page-copy";
import { logOperationalEvent } from "@/lib/operational-visibility/logger";
import { buildOperationalRequestContext } from "@/lib/operational-visibility/request-context";
import { getSessionDataContext } from "@/lib/session-data/auth";
import { readActiveSessionBadge, type ActiveSessionBadge } from "@/lib/session-flow/active-session-badge";
import { readCurrentAvatarChoice } from "@/lib/session-flow/avatar-choice";
import { readSessionQuota } from "@/lib/session-data/quota";
import type { SessionQuota } from "@/lib/session-data/types";
import { formatSessionBudgetMinutes, resolveSessionDurationSeconds } from "@/lib/session-flow/session-budget";

const locale = Astro.locals.locale;
const copy = getAvatarPageCopy(locale);
const queryErrorCode = parseAvatarChoiceErrorCode(Astro.url.searchParams.get(AVATAR_CHOICE_ERROR_PARAM));
const operationalContext = await buildOperationalRequestContext(Astro);
const sessionContext = getSessionDataContext(Astro);

let currentSelection: SelectedModalityAvatar | null = null;
let activeSession: ActiveSessionBadge | null = null;
let sessionQuota: SessionQuota | null = null;
let pageError = queryErrorCode ? getAvatarChoiceErrorMessage(locale, queryErrorCode) : null;

if (!sessionContext.ok) {
  pageError = getAvatarChoiceErrorMessage(
    locale,
    sessionContext.error.code === "missing_auth" ? "missing_auth" : "config_unavailable",
  );
  logOperationalEvent(
    {
      event: "avatar.fetch",
      level: sessionContext.error.code === "missing_auth" ? "warn" : "error",
      outcome: "failure",
      status: 200,
      reasonCode: sessionContext.error.code === "missing_auth" ? "missing_auth" : "config_unavailable",
    },
    operationalContext,
  );
} else {
  const avatarChoice = await readCurrentAvatarChoice(sessionContext.data);

  if (avatarChoice.ok) {
    currentSelection = avatarChoice.data.selected;
    logOperationalEvent(
      {
        event: "avatar.fetch",
        level: "info",
        outcome: "success",
        status: 200,
        provider: "supabase",
      },
      operationalContext,
    );
  } else if (avatarChoice.error.code === "missing_avatar") {
    // Pierwszy wybór nie jest błędem — strona po prostu startuje bez zaznaczenia.
    logOperationalEvent(
      {
        event: "avatar.fetch",
        level: "info",
        outcome: "success",
        status: 200,
        provider: "supabase",
      },
      operationalContext,
    );
  } else {
    pageError = getAvatarChoiceErrorMessage(
      locale,
      avatarChoice.error.code === "invalid_avatar_choice" ? "invalid_choice" : "fetch_failed",
    );
    logOperationalEvent(
      {
        event: "avatar.fetch",
        level: "warn",
        outcome: "failure",
        status: 200,
        reasonCode: avatarChoice.error.code === "invalid_avatar_choice" ? "invalid_choice" : "fetch_failed",
        provider: "supabase",
      },
      operationalContext,
    );
  }

  // Rozmowa w toku może należeć do innej perspektywy niż ta właśnie zapisana —
  // ostrzeżenie i pill w nagłówku mają ją pokazać tak czy inaczej.
  activeSession = await readActiveSessionBadge(sessionContext.data);

  const quota = await readSessionQuota(sessionContext.data);

  sessionQuota = quota.ok ? quota.data : null;
}

/*
 * Wybór perspektywy może od razu prowadzić do rozmowy, ale tylko wtedy, gdy jest
 * co zaczynać: żadna rozmowa nie trwa i pula nie została wyczerpana. Właściwą
 * bramką pozostaje panel i trasy startu — to jest wyłącznie decyzja o tym, czy
 * obiecywać start drugim przyciskiem.
 */
const canStartConversation =
  activeSession === null &&
  sessionQuota !== null &&
  (sessionQuota.plan === "premium" || (sessionQuota.remainingSessions ?? 0) > 0);
const sessionBudgetMinutes = formatSessionBudgetMinutes(locale, resolveSessionDurationSeconds(sessionQuota?.plan));
---

<Layout title={copy.pageTitle}>
  <div class="bg-paper text-ink flex min-h-screen flex-col">
    <AppHeader activeSession={activeSession} />

    <main class="flex-1 px-4 py-5 sm:px-6 sm:py-8 lg:px-8">
      <section class="mx-auto max-w-6xl">
        {
          /* Two long paragraphs plus a privacy card used to fill the entire first
            mobile screen, so the actual choice started below the fold. The detail
            stays available, just folded away until someone wants it. */
        }
        <a
          href="/dashboard"
          class="text-ink-muted hover:text-ink focus-visible:ring-brand-ring inline-flex min-h-11 items-center gap-1.5 rounded text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4"
          >
            <path d="M19 12H5M11 18l-6-6 6-6"></path>
          </svg>
          {copy.back}
        </a>
        <h1 class="text-ink mt-3 max-w-4xl font-serif text-4xl font-medium tracking-tight">{copy.title}</h1>
        <p class="text-ink-muted mt-3 max-w-3xl text-[17px] leading-7">{copy.intro}</p>

        <details class="group mt-3 max-w-3xl">
          <summary
            class="text-brand hover:text-brand-deep focus-visible:ring-brand-ring inline-flex min-h-11 cursor-pointer list-none items-center gap-1 rounded text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2"
          >
            {copy.disclosure}
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4 transition-transform group-open:rotate-180"
            >
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </summary>
          <div class="text-ink-muted mt-3 space-y-2 text-sm leading-6">
            {copy.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </details>

        {
          activeSession ? (
            <div class="border-line-accent bg-surface text-brand-deep mt-6 max-w-3xl rounded-2xl border p-4 text-sm leading-6">
              {copy.activeNotice}
            </div>
          ) : null
        }

        {
          pageError ? (
            <div class="border-danger-line bg-danger-soft text-danger mt-6 rounded-2xl border p-4 text-sm leading-6">
              {pageError}
            </div>
          ) : null
        }

        <AvatarChoiceForm
          client:idle
          locale={locale}
          modalities={MODALITY_CHOICES}
          currentSelection={currentSelection}
          canStartConversation={canStartConversation}
          sessionBudgetMinutes={sessionBudgetMinutes}
        />
      </section>
    </main>

    <SiteFooter />
  </div>
</Layout>
