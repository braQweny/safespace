---
import AppHeader from "@/components/AppHeader.astro";
import AvatarChoiceForm from "@/components/modality/AvatarChoiceForm";
import Layout from "@/layouts/Layout.astro";
import {
  AVATAR_CHOICE_ERROR_PARAM,
  getAvatarChoiceErrorMessage,
  parseAvatarChoiceErrorCode,
} from "@/lib/avatar-choice-errors";
import {
  getModalityByAvatarId,
  getValidAvatarChoice,
  MVP_MODALITIES,
  toSelectedModalityAvatar,
  type SelectedModalityAvatar,
} from "@/lib/modalities";
import { logOperationalEvent } from "@/lib/operational-visibility/logger";
import { buildOperationalRequestContext } from "@/lib/operational-visibility/request-context";
import { getSessionDataContext } from "@/lib/session-data/auth";
import { parseSessionHistoryPage, readSessionHistoryList } from "@/lib/session-flow/session-history";
import type { SessionHistoryListResponse } from "@/lib/session-flow/session-history-contract";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const queryErrorCode = parseAvatarChoiceErrorCode(Astro.url.searchParams.get(AVATAR_CHOICE_ERROR_PARAM));
const operationalContext = await buildOperationalRequestContext(Astro);
const queryAvatar = getModalityByAvatarId(Astro.url.searchParams.get("avatar"));
const queryPage = parseSessionHistoryPage(Astro.url.searchParams.get("page"));
const initialHistoryPage = queryPage.ok ? queryPage.page : 1;

let currentSelection: SelectedModalityAvatar | null = queryAvatar ? toSelectedModalityAvatar(queryAvatar) : null;
let savedSelection: SelectedModalityAvatar | null = null;
let initialHistory: SessionHistoryListResponse | null = null;
let pageError = queryErrorCode ? getAvatarChoiceErrorMessage(queryErrorCode) : null;

if (!user) {
  pageError = getAvatarChoiceErrorMessage("missing_auth");
  logOperationalEvent(
    {
      event: "avatar.fetch",
      level: "warn",
      outcome: "failure",
      status: 200,
      reasonCode: "missing_auth",
    },
    operationalContext,
  );
} else if (!supabase) {
  pageError = getAvatarChoiceErrorMessage("config_unavailable");
  logOperationalEvent(
    {
      event: "avatar.fetch",
      level: "error",
      outcome: "failure",
      status: 200,
      reasonCode: "config_unavailable",
      provider: "supabase",
    },
    operationalContext,
  );
} else {
  const { data, error } = await supabase
    .from("user_avatar_choices")
    .select("modality_id, avatar_id")
    .eq("user_id", user.id)
    .maybeSingle();

  if (error) {
    pageError = getAvatarChoiceErrorMessage("fetch_failed");
    logOperationalEvent(
      {
        event: "avatar.fetch",
        level: "warn",
        outcome: "failure",
        status: 200,
        reasonCode: "fetch_failed",
        provider: "supabase",
      },
      operationalContext,
    );
  } else if (data) {
    const selectedChoice = getValidAvatarChoice(data.modality_id, data.avatar_id);
    savedSelection = selectedChoice ? toSelectedModalityAvatar(selectedChoice) : null;
    currentSelection = currentSelection ?? savedSelection;
    logOperationalEvent(
      {
        event: "avatar.fetch",
        level: "info",
        outcome: "success",
        status: 200,
        provider: "supabase",
      },
      operationalContext,
    );
  } else {
    logOperationalEvent(
      {
        event: "avatar.fetch",
        level: "info",
        outcome: "success",
        status: 200,
        provider: "supabase",
      },
      operationalContext,
    );
  }
}

if (!pageError && currentSelection) {
  const sessionContext = getSessionDataContext(Astro);

  if (sessionContext.ok) {
    initialHistory = await readSessionHistoryList(sessionContext.data, {
      avatar: currentSelection.avatarId,
      page: String(initialHistoryPage),
    });
  }
}
---

<Layout title="Wybór awatara - SafeSpace" lang="pl">
  <div class="bg-canvas text-ink flex min-h-screen flex-col">
    <AppHeader current="avatar" />

    <main class="flex-1 px-4 py-8 sm:px-6 lg:px-8">
      <section class="mx-auto max-w-6xl">
        {
          /* Two long paragraphs plus a privacy card used to fill the entire first
            mobile screen, so the actual choice started below the fold. The detail
            stays available, just folded away until someone wants it. */
        }
        <h1 class="text-ink max-w-4xl text-3xl font-semibold">Wybierz perspektywę rozmowy</h1>
        <p class="text-ink-soft mt-3 max-w-3xl text-base leading-7">
          Każdy awatar prowadzi rozmowę w innym stylu. Wybór dotyczy kolejnej sesji i możesz go później zmienić.
        </p>

        <details class="group mt-3 max-w-3xl">
          <summary
            class="text-brand focus:ring-brand-ring inline-flex cursor-pointer list-none items-center gap-1 rounded text-sm font-medium focus:ring-2 focus:outline-none"
          >
            Co to znaczy i co widać w historii
            <span aria-hidden="true" class="transition-transform group-open:rotate-180">▾</span>
          </summary>
          <div class="text-ink-muted mt-3 space-y-2 text-sm leading-6">
            <p>
              To edukacyjny wybór perspektywy do przyszłej symulacji rozmowy. SafeSpace nie zastępuje specjalisty i nie
              dobiera nurtu za Ciebie; decyzje dotyczące realnej terapii warto omawiać z wykwalifikowaną osobą.
            </p>
            <p>
              Możesz przełączać awatary, żeby sprawdzić zapisane rozmowy dla danej perspektywy, zanim zapiszesz nowy
              wybór. Lista historii nie pokazuje fragmentów rozmowy — pełna treść jest dostępna dopiero po otwarciu
              zapisu tylko do odczytu.
            </p>
          </div>
        </details>

        {
          pageError ? (
            <div class="border-danger-line bg-danger-soft text-danger mt-6 rounded-lg border p-4 text-sm leading-6">
              {pageError}
            </div>
          ) : null
        }

        <AvatarChoiceForm
          client:load
          modalities={MVP_MODALITIES}
          currentSelection={currentSelection}
          initialHistoryPage={initialHistoryPage}
          initialHistory={initialHistory}
        />
      </section>
    </main>
  </div>
</Layout>
