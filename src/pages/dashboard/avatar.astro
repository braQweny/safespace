---
import AvatarChoiceForm from "@/components/modality/AvatarChoiceForm";
import Layout from "@/layouts/Layout.astro";
import {
  AVATAR_CHOICE_ERROR_PARAM,
  getAvatarChoiceErrorMessage,
  parseAvatarChoiceErrorCode,
} from "@/lib/avatar-choice-errors";
import { getValidAvatarChoice, MVP_MODALITIES, toSelectedModalityAvatar } from "@/lib/modalities";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const queryErrorCode = parseAvatarChoiceErrorCode(Astro.url.searchParams.get(AVATAR_CHOICE_ERROR_PARAM));

let currentSelection = null;
let pageError = queryErrorCode ? getAvatarChoiceErrorMessage(queryErrorCode) : null;

if (!user) {
  pageError = getAvatarChoiceErrorMessage("missing_auth");
} else if (!supabase) {
  pageError = getAvatarChoiceErrorMessage("config_unavailable");
} else {
  const { data, error } = await supabase
    .from("user_avatar_choices")
    .select("modality_id, avatar_id")
    .eq("user_id", user.id)
    .maybeSingle();

  if (error) {
    pageError = getAvatarChoiceErrorMessage("fetch_failed");
  } else if (data) {
    const selectedChoice = getValidAvatarChoice(data.modality_id, data.avatar_id);
    currentSelection = selectedChoice ? toSelectedModalityAvatar(selectedChoice) : null;
  }
}
---

<Layout title="Wybór awatara - SafeSpace" lang="pl">
  <main class="min-h-screen bg-[#f4faf7] px-4 py-8 text-[#12201d] sm:px-6 lg:px-8">
    <section class="mx-auto max-w-7xl">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-sm font-medium text-[#1f6f65]">SafeSpace</p>
          <h1 class="mt-3 max-w-4xl text-3xl font-semibold text-[#10231f]">Wybierz awatara psychoterapeutycznego</h1>
        </div>
        <a
          href="/dashboard"
          class="inline-flex h-10 items-center justify-center rounded-lg border border-[#9cc8bc] bg-white px-4 text-sm font-medium text-[#1f6f65] transition-colors hover:bg-[#eef8f4] focus:ring-2 focus:ring-[#2d8a7d] focus:outline-none"
        >
          Wróć do panelu
        </a>
      </div>

      <div class="mt-6 grid gap-4 lg:grid-cols-[minmax(0,1fr)_360px]">
        <div>
          <p class="max-w-3xl text-base leading-7 text-[#38524b]">
            To edukacyjny wybór perspektywy do przyszłej symulacji rozmowy. SafeSpace nie zastępuje specjalisty i nie
            dobiera nurtu za Ciebie; decyzje dotyczące realnej terapii warto omawiać z wykwalifikowaną osobą.
          </p>
          <p class="mt-3 max-w-3xl text-sm leading-6 text-[#52645f]">
            Możesz zmienić wybór przed pierwszą sesją. Sama sesja, timer i rozmowa AI należą do kolejnego etapu
            roadmapy.
          </p>
        </div>
        <aside class="rounded-lg border border-[#d7e5e0] bg-white p-4 text-sm leading-6 text-[#52645f]">
          <p class="font-semibold text-[#173f39]">Granica produktu</p>
          <p class="mt-2">
            Awatar opisuje styl przyszłej symulacji. Nie jest terapeutą ani wskazaniem konkretnego nurtu pracy.
          </p>
        </aside>
      </div>

      {
        pageError ? (
          <div class="mt-6 rounded-lg border border-[#f0c7c7] bg-[#fff8f8] p-4 text-sm leading-6 text-[#7d2d2d]">
            {pageError}
          </div>
        ) : null
      }

      <AvatarChoiceForm client:load modalities={MVP_MODALITIES} currentSelection={currentSelection} />
    </section>
  </main>
</Layout>
