---
import AppHeader from "@/components/AppHeader.astro";
import AvatarChoiceForm from "@/components/modality/AvatarChoiceForm";
import SiteFooter from "@/components/SiteFooter.astro";
import Layout from "@/layouts/Layout.astro";
import {
  AVATAR_CHOICE_ERROR_PARAM,
  getAvatarChoiceErrorMessage,
  parseAvatarChoiceErrorCode,
} from "@/lib/avatar-choice-errors";
import { MVP_MODALITIES, type SelectedModalityAvatar } from "@/lib/modalities";
import { logOperationalEvent } from "@/lib/operational-visibility/logger";
import { buildOperationalRequestContext } from "@/lib/operational-visibility/request-context";
import { getSessionDataContext } from "@/lib/session-data/auth";
import { readActiveSessionBadge, type ActiveSessionBadge } from "@/lib/session-flow/active-session-badge";
import { readCurrentAvatarChoice } from "@/lib/session-flow/avatar-choice";

const queryErrorCode = parseAvatarChoiceErrorCode(Astro.url.searchParams.get(AVATAR_CHOICE_ERROR_PARAM));
const operationalContext = await buildOperationalRequestContext(Astro);
const sessionContext = getSessionDataContext(Astro);

let currentSelection: SelectedModalityAvatar | null = null;
let activeSession: ActiveSessionBadge | null = null;
let pageError = queryErrorCode ? getAvatarChoiceErrorMessage(queryErrorCode) : null;

if (!sessionContext.ok) {
  pageError = getAvatarChoiceErrorMessage(
    sessionContext.error.code === "missing_auth" ? "missing_auth" : "config_unavailable",
  );
  logOperationalEvent(
    {
      event: "avatar.fetch",
      level: sessionContext.error.code === "missing_auth" ? "warn" : "error",
      outcome: "failure",
      status: 200,
      reasonCode: sessionContext.error.code === "missing_auth" ? "missing_auth" : "config_unavailable",
    },
    operationalContext,
  );
} else {
  const avatarChoice = await readCurrentAvatarChoice(sessionContext.data);

  if (avatarChoice.ok) {
    currentSelection = avatarChoice.data.selected;
    logOperationalEvent(
      {
        event: "avatar.fetch",
        level: "info",
        outcome: "success",
        status: 200,
        provider: "supabase",
      },
      operationalContext,
    );
  } else if (avatarChoice.error.code === "missing_avatar") {
    // Pierwszy wybór nie jest błędem — strona po prostu startuje bez zaznaczenia.
    logOperationalEvent(
      {
        event: "avatar.fetch",
        level: "info",
        outcome: "success",
        status: 200,
        provider: "supabase",
      },
      operationalContext,
    );
  } else {
    pageError = getAvatarChoiceErrorMessage(
      avatarChoice.error.code === "invalid_avatar_choice" ? "invalid_choice" : "fetch_failed",
    );
    logOperationalEvent(
      {
        event: "avatar.fetch",
        level: "warn",
        outcome: "failure",
        status: 200,
        reasonCode: avatarChoice.error.code === "invalid_avatar_choice" ? "invalid_choice" : "fetch_failed",
        provider: "supabase",
      },
      operationalContext,
    );
  }

  // Rozmowa w toku może należeć do innej perspektywy niż ta właśnie zapisana —
  // ostrzeżenie i pill w nagłówku mają ją pokazać tak czy inaczej.
  activeSession = await readActiveSessionBadge(sessionContext.data);
}
---

<Layout title="Wybór perspektywy - SafeSpace" lang="pl">
  <div class="bg-canvas text-ink flex min-h-screen flex-col">
    <AppHeader activeSession={activeSession} />

    <main class="flex-1 px-4 py-8 sm:px-6 lg:px-8">
      <section class="mx-auto max-w-6xl">
        {
          /* Two long paragraphs plus a privacy card used to fill the entire first
            mobile screen, so the actual choice started below the fold. The detail
            stays available, just folded away until someone wants it. */
        }
        <a
          href="/dashboard"
          class="text-brand hover:text-brand-strong focus:ring-brand-ring rounded text-sm font-medium transition-colors hover:underline focus:ring-2 focus:outline-none"
        >
          ← Wróć do panelu
        </a>
        <h1 class="text-ink mt-3 max-w-4xl text-3xl font-semibold">Wybierz perspektywę rozmowy</h1>
        <p class="text-ink-soft mt-3 max-w-3xl text-base leading-7">
          Każda perspektywa to inny awatar i inny nurt psychoterapii — rozmowa będzie prowadzona w jego stylu. Wybór
          dotyczy kolejnej rozmowy i możesz go później zmienić; po zapisaniu wrócisz do panelu, skąd zaczniesz rozmowę.
        </p>

        <details class="group mt-3 max-w-3xl">
          <summary
            class="text-brand focus:ring-brand-ring inline-flex cursor-pointer list-none items-center gap-1 rounded text-sm font-medium focus:ring-2 focus:outline-none"
          >
            Co to znaczy dla rozmowy
            <span aria-hidden="true" class="transition-transform group-open:rotate-180">▾</span>
          </summary>
          <div class="text-ink-muted mt-3 space-y-2 text-sm leading-6">
            <p>
              To edukacyjny wybór perspektywy do przyszłej symulacji rozmowy. SafeSpace nie zastępuje specjalisty i nie
              dobiera nurtu za Ciebie; decyzje dotyczące realnej terapii warto omawiać z wykwalifikowaną osobą.
            </p>
            <p>
              Zapisy rozmów są prowadzone osobno dla każdej perspektywy. Znajdziesz je w panelu, w historii rozmów — tam
              też przełączysz się między perspektywami, żeby przejrzeć starsze zapisy.
            </p>
          </div>
        </details>

        {
          activeSession ? (
            <div class="border-line-accent bg-surface-hover text-brand-deep mt-6 max-w-3xl rounded-lg border p-4 text-sm leading-6">
              Masz rozmowę w toku. Zapisana tu zmiana zadziała dopiero od następnej rozmowy.
            </div>
          ) : null
        }

        {
          pageError ? (
            <div class="border-danger-line bg-danger-soft text-danger mt-6 rounded-lg border p-4 text-sm leading-6">
              {pageError}
            </div>
          ) : null
        }

        <AvatarChoiceForm client:load modalities={MVP_MODALITIES} currentSelection={currentSelection} />
      </section>
    </main>

    <SiteFooter />
  </div>
</Layout>
