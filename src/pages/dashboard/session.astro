---
import Layout from "@/layouts/Layout.astro";
import TimedSession from "@/components/session/TimedSession";
import { getPeopleCardsCopy } from "@/components/people/people-cards-copy";
import { getTopicMapCopy } from "@/components/topics/topic-map-copy";
import {
  getLatestOwnedSessionSummaryState,
  getOwnedDifficultyCard,
  getOwnedPersonCard,
} from "@/lib/session-data/repository";
import type { LatestSessionSummaryState } from "@/lib/session-data/types";
import { getSessionCopy } from "@/lib/session-copy";
import { getSessionDataContext } from "@/lib/session-data/auth";
import { readCurrentAvatarChoice } from "@/lib/session-flow/avatar-choice";
import { isPeopleMemoryEnabled } from "@/lib/session-flow/people-memory-mode";
import { parseSessionIdParam } from "@/lib/session-flow/session-id";
import { readSessionStartPageState } from "@/lib/session-flow/session-state";
import { isTopicMapEnabled } from "@/lib/session-flow/topic-map-mode";

const sessionContext = getSessionDataContext(Astro);
const resumeSessionId = Astro.url.searchParams.get("sessionId");
// Karta osoby z „Porozmawiaj o tej osobie” — w adresie tylko id, nigdy imię.
const aboutPersonId = parseSessionIdParam(Astro.url.searchParams.get("about") ?? undefined);
// Trudność z „Porozmawiaj o tym” na mapie tematów — tak samo tylko id, nigdy etykieta.
const aboutDifficultyId = parseSessionIdParam(Astro.url.searchParams.get("topic") ?? undefined);
const peopleMemoryMode = isPeopleMemoryEnabled();
const topicMapMode = isTopicMapEnabled();

// Rozmowę rozpoczyna się w panelu, więc ta strona istnieje wyłącznie dla sesji,
// która już trwa albo właśnie się zakończyła. Każdy inny stan wraca do panelu —
// tam stoi przycisk startu i informacja, z czym rozmowa się zacznie.
if (!sessionContext.ok) {
  return Astro.redirect("/dashboard");
}

const avatarChoice = await readCurrentAvatarChoice(sessionContext.data);

if (!avatarChoice.ok) {
  return Astro.redirect("/dashboard");
}

const startPageState = await readSessionStartPageState(sessionContext.data, {
  avatar: avatarChoice.data,
  includeMessagesForActive: true,
  resumeSessionId,
});

if (!startPageState.ok || !startPageState.data.session) {
  return Astro.redirect("/dashboard");
}

const pageState = startPageState.data;
const activeSession = pageState.session;
let initialSummary: LatestSessionSummaryState | null = null;
let initialDraft: string | null = null;

// Podsumowanie decyduje o kolejnej rozmowie, więc wjeżdża razem z ekranem
// zakończenia zamiast czekać na odnalezienie rozmowy w historii.
if (activeSession && pageState.kind !== "active") {
  const summaryState = await getLatestOwnedSessionSummaryState(sessionContext.data, activeSession.id);
  initialSummary = summaryState.ok ? summaryState.data : null;
}

// Prefill z karty: tylko dla trwającej rozmowy tej samej perspektywy i tylko
// dopóki użytkownik sam nic nie napisał — odświeżenie po wysłaniu nie wraca z
// tym zdaniem. Cudza albo nieistniejąca karta po prostu nic nie wstawia.
// Osoba ma pierwszeństwo przed trudnością, gdy adres niesie obie.
const acceptsPrefill = pageState.kind === "active" && !pageState.messages.some((message) => message.role === "user");

if (aboutPersonId && peopleMemoryMode && acceptsPrefill) {
  const card = await getOwnedPersonCard(sessionContext.data, aboutPersonId);

  if (card.ok && card.data?.avatarId === avatarChoice.data.selected.avatarId) {
    initialDraft = getPeopleCardsCopy(Astro.locals.locale).talkAboutDraft(card.data.name, card.data.relation);
  }
}

if (initialDraft === null && aboutDifficultyId && topicMapMode && acceptsPrefill) {
  const difficulty = await getOwnedDifficultyCard(sessionContext.data, aboutDifficultyId);

  if (difficulty.ok && difficulty.data?.avatarId === avatarChoice.data.selected.avatarId) {
    initialDraft = getTopicMapCopy(Astro.locals.locale).talkAboutDraft(difficulty.data.label);
  }
}
---

<Layout title={getSessionCopy(Astro.locals.locale).pageTitle}>
  {
    /*
    Jedyna strona bez `AppHeader`: rozmowa ma własny pasek, a dwa nagłówki jeden
    nad drugim zabierały na telefonie 120 z 844 px, zanim cokolwiek się zaczęło.
    Powrót do panelu — jedyne, co robił tu nagłówek aplikacji — przejął łuk
    w pasku rozmowy. Konto i wylogowanie zostają w panelu; rozmowa jest jednym
    zadaniem i nie potrzebuje menu.
  */
  }
  <div class="bg-paper text-ink flex h-[100dvh] flex-col">
    {
      /*
      `display: contents` na wyspie Astro, żeby wysokość 100dvh dochodziła do layoutu rozmowy.
      `relative`: elementy `sr-only` (position: absolute) w zapisie i pod polem pisania muszą
      mieć containing block tutaj — bez tego wypadają poza `overflow-hidden`, rozciągają
      dokument i telefon pozwala przeciągnąć całą rozmowę w górę, zostawiając pusty pas.
    */
    }
    <main class="relative min-h-0 flex-1 overflow-hidden [&>astro-island]:contents">
      <TimedSession
        client:load
        locale={Astro.locals.locale}
        initialState={pageState}
        initialSummary={initialSummary}
        initialDraft={initialDraft}
        prepareCards={peopleMemoryMode || topicMapMode}
      />
    </main>
  </div>
</Layout>
