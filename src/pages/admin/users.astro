---
import Layout from "@/layouts/Layout.astro";
import AdminShell from "@/components/admin/AdminShell.astro";
import AdminUsersTable from "@/components/admin/AdminUsersTable";
import { getAdminContext } from "@/lib/admin/auth";
import { adminApiFailure, type AdminUsersResponse } from "@/lib/admin/contracts";
import { listAdminUsers, parseAdminUserListFilters } from "@/lib/admin/users";
import { getAdminCopy } from "@/components/admin/admin-copy";

const locale = Astro.locals.locale;
const copy = getAdminCopy(locale).pages;
const adminContext = await getAdminContext(Astro);
let usersResponse: AdminUsersResponse = adminApiFailure(
  adminContext.ok ? "admin_data_unavailable" : adminContext.error.code,
);

if (adminContext.ok) {
  const filters = parseAdminUserListFilters(Astro.url.searchParams);

  if (filters.ok) {
    const users = await listAdminUsers(adminContext.data, filters.data);
    usersResponse = users.ok
      ? { ok: true, type: "admin_users", result: users.data }
      : adminApiFailure(users.error.code);
  } else {
    usersResponse = adminApiFailure(filters.error.code);
  }
}
---

<Layout title={copy.usersPageTitle}>
  {
    adminContext.ok ? (
      <AdminShell title={copy.usersTitle} active="users" adminEmail={adminContext.data.user.email}>
        <AdminUsersTable
          locale={locale}
          initialResponse={usersResponse}
          currentAdminUserId={adminContext.data.user.id}
          client:idle
        />
      </AdminShell>
    ) : (
      <main class="text-ink bg-paper min-h-screen px-4 py-10">
        <section class="border-line bg-surface mx-auto max-w-2xl rounded-lg border p-6">
          <h1 class="text-ink text-3xl leading-tight">{copy.noAccessTitle}</h1>
          <p class="text-ink-muted mt-3 text-sm leading-6">{copy.noAccessBody}</p>
          <a
            href="/dashboard"
            class="text-brand hover:text-brand-strong mt-4 inline-block text-sm font-medium transition-colors hover:underline"
          >
            {copy.backToDashboard}
          </a>
        </section>
      </main>
    )
  }
</Layout>
