---
import Layout from "@/layouts/Layout.astro";
import AdminOverview from "@/components/admin/AdminOverview";
import AdminShell from "@/components/admin/AdminShell.astro";
import { getAdminContext } from "@/lib/admin/auth";
import { readAdminOverviewMetrics } from "@/lib/admin/aggregates";

const adminContext = await getAdminContext(Astro);
const overview = adminContext.ok ? await readAdminOverviewMetrics(adminContext.data) : null;
---

<Layout title="Admin - SafeSpace" lang="pl">
  {
    adminContext.ok ? (
      <AdminShell title="Statystyki produktu" active="overview" adminEmail={adminContext.data.user.email}>
        {overview?.ok ? (
          <AdminOverview metrics={overview.data} />
        ) : (
          <div class="rounded-lg border border-[#f0c7c7] bg-[#fff8f8] p-4 text-sm text-[#7d2d2d]">
            Nie udało się pobrać statystyk admina.
          </div>
        )}
      </AdminShell>
    ) : (
      <main class="min-h-screen bg-[#f5f7f7] px-4 py-10 text-[#17211f]">
        <section class="mx-auto max-w-2xl rounded-lg border border-[#d7e2df] bg-white p-6">
          <h1 class="text-2xl font-semibold text-[#10231f]">Brak dostępu</h1>
          <p class="mt-3 text-sm leading-6 text-[#52645f]">
            Ta część produktu jest dostępna tylko dla aktywnych adminów.
          </p>
        </section>
      </main>
    )
  }
</Layout>
