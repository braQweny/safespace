---
import Layout from "@/layouts/Layout.astro";

const isSignedIn = Boolean(Astro.locals.user);

const content = isSignedIn
  ? {
      heading: "Konto jest aktywne",
      description: "Możesz przejść do prywatnej części SafeSpace.",
      href: "/dashboard",
      linkText: "Przejdź do panelu",
    }
  : {
      heading: "Sprawdź e-mail",
      description: "Jeśli projekt wymaga potwierdzenia adresu, użyj linku z wiadomości, a potem zaloguj się ponownie.",
      href: "/auth/signin",
      linkText: "Wróć do logowania",
    };
---

<Layout title={`${content.heading} - SafeSpace`} lang="pl">
  <main class="flex min-h-screen items-center justify-center bg-[#f4faf7] px-4 py-10 text-[#12201d]">
    <section
      class="w-full max-w-md rounded-lg border border-[#c8ddd7] bg-white p-6 text-center shadow-[0_22px_60px_rgba(24,78,70,0.12)] sm:p-8"
    >
      <a href="/" class="text-sm font-medium text-[#1f6f65] transition-colors hover:text-[#164e47] hover:underline">
        SafeSpace
      </a>
      <h1 class="mt-3 text-2xl font-semibold text-[#10231f]">{content.heading}</h1>
      <p class="mt-3 text-sm leading-6 text-[#52645f]">{content.description}</p>
      <a
        href={content.href}
        class="mt-6 inline-flex h-11 items-center justify-center rounded-lg bg-[#1f6f65] px-5 text-sm font-medium text-white transition-colors hover:bg-[#185950] focus:ring-2 focus:ring-[#2d8a7d] focus:outline-none"
      >
        {content.linkText}
      </a>
    </section>
  </main>
</Layout>
