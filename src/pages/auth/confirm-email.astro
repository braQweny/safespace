---
import Layout from "@/layouts/Layout.astro";
import { SOCIAL_AUTH_PROVIDERS } from "@/lib/auth-providers";

const isSignedIn = Boolean(Astro.locals.user);

const content = isSignedIn
  ? {
      heading: "Konto jest aktywne",
      description: "Możesz przejść do prywatnej części SafeSpace.",
      href: "/dashboard",
      linkText: "Przejdź do panelu",
    }
  : {
      heading: "Sprawdź skrzynkę",
      description:
        "Jeśli rejestracja wymaga potwierdzenia, wyślemy e-mail z linkiem. Jeśli ten adres był wcześniej użyty z Google, wiadomość może nie przyjść — wtedy zaloguj się przez Google i ustaw hasło w ustawieniach konta.",
      href: "/auth/signin",
      linkText: "Wróć do logowania",
    };
---

<Layout title={`${content.heading} - SafeSpace`} lang="pl">
  <main class="bg-canvas text-ink flex min-h-screen items-center justify-center px-4 py-10">
    <section
      class="border-line-strong w-full max-w-md rounded-lg border bg-white p-6 text-center shadow-[0_22px_60px_rgba(24,78,70,0.12)] sm:p-8"
    >
      <a href="/" class="text-brand hover:text-brand-strong text-sm font-medium transition-colors hover:underline">
        SafeSpace
      </a>
      <h1 class="text-ink mt-3 text-2xl font-semibold">{content.heading}</h1>
      <p class="text-ink-muted mt-3 text-sm leading-6">{content.description}</p>
      {
        isSignedIn ? (
          <a
            href={content.href}
            class="bg-brand hover:bg-brand-strong focus:ring-brand-ring mt-6 inline-flex h-11 items-center justify-center rounded-lg px-5 text-sm font-medium text-white transition-colors focus:ring-2 focus:outline-none"
          >
            {content.linkText}
          </a>
        ) : (
          <div class="mt-6 space-y-3">
            {SOCIAL_AUTH_PROVIDERS.map((authProvider) => (
              <form method="POST" action="/api/auth/google">
                <button
                  type="submit"
                  class="bg-brand hover:bg-brand-strong focus:ring-brand-ring flex h-11 w-full items-center justify-center gap-3 rounded-lg px-4 text-sm font-medium text-white transition-colors focus:ring-2 focus:outline-none"
                >
                  <span class="flex size-6 items-center justify-center rounded-full border border-white/40 text-sm font-semibold">
                    G
                  </span>
                  {authProvider.buttonLabel}
                </button>
              </form>
            ))}
            <a
              href={content.href}
              class="border-line-accent text-brand hover:bg-surface-hover focus:ring-brand-ring inline-flex h-11 w-full items-center justify-center rounded-lg border bg-white px-5 text-sm font-medium transition-colors focus:ring-2 focus:outline-none"
            >
              {content.linkText}
            </a>
          </div>
        )
      }
    </section>
  </main>
</Layout>
