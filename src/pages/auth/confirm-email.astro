---
import AppHeader from "@/components/AppHeader.astro";
import Layout from "@/layouts/Layout.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { getAuthErrorMessageFromSearchParam } from "@/lib/auth-errors";
import { SOCIAL_AUTH_PROVIDERS } from "@/lib/auth-providers";
import { getAuthPagesCopy } from "@/lib/page-copy/auth-pages-copy";

const pagesCopy = getAuthPagesCopy(Astro.locals.locale);
const copy = pagesCopy.confirm;
const isSignedIn = Boolean(Astro.locals.user);
const error = getAuthErrorMessageFromSearchParam(Astro.locals.locale, Astro.url.searchParams.get("error"));
const wasResent = Astro.url.searchParams.get("resent") === "1";

const heading = isSignedIn ? copy.headingSignedIn : copy.headingInbox;
---

<Layout title={copy.pageTitle(heading)}>
  <div class="bg-paper text-ink flex min-h-screen flex-col">
    <AppHeader />

    <main class="flex flex-1 items-center justify-center px-4 py-10">
      <section
        class="border-line-strong bg-surface shadow-card w-full max-w-md rounded-[20px] border p-6 text-center sm:p-8"
      >
        <h1 class="text-ink text-3xl leading-tight">{heading}</h1>
        {
          isSignedIn ? (
            <>
              <p class="text-ink-muted mt-3 text-sm leading-6">{copy.signedInBody}</p>
              <a
                href="/dashboard"
                class="bg-brand text-surface hover:bg-brand-strong focus-visible:ring-brand-ring mt-6 inline-flex h-12 items-center justify-center rounded-[14px] px-6 text-[15px] font-semibold transition-colors focus:outline-none focus-visible:ring-2"
              >
                {copy.goToDashboard}
              </a>
            </>
          ) : (
            <>
              <p class="text-ink-muted mt-3 text-sm leading-6">
                <span data-confirm-email-generic>{copy.sentGeneric}</span>
                <span data-confirm-email-target hidden>
                  {copy.sentToPrefix} <strong class="text-ink font-semibold" data-confirm-email />.
                </span>
                {copy.instructions}
              </p>
              <p class="text-ink-muted mt-3 text-sm leading-6">{copy.googleNote}</p>

              {wasResent ? (
                <div
                  role="status"
                  class="border-brand-soft text-brand-deep bg-brand-tint mt-6 rounded-2xl border p-4 text-left text-sm leading-6"
                >
                  {copy.resent}
                </div>
              ) : null}

              <form
                method="POST"
                action="/api/auth/resend-confirmation"
                class="border-line mt-6 space-y-4 rounded-2xl border p-4 text-left"
                aria-labelledby="resend-confirmation-heading"
                data-remembered-email-form
                data-has-error={error ? "true" : "false"}
              >
                <h2 id="resend-confirmation-heading" class="text-ink text-base font-semibold">
                  {copy.resendTitle}
                </h2>

                {error ? (
                  <p
                    role="alert"
                    class="border-danger-line bg-danger-soft text-danger rounded-xl border p-3.5 text-sm leading-6"
                  >
                    {error}
                  </p>
                ) : null}

                <div>
                  <label for="email" class="text-brand-deep text-sm font-medium">
                    {copy.emailLabel}
                  </label>
                  <input
                    id="email"
                    name="email"
                    type="email"
                    required
                    autocomplete="email"
                    class="border-line-strong bg-surface text-ink focus-visible:ring-brand-ring placeholder:text-ink-muted mt-1.5 h-12 w-full rounded-[14px] border px-3.5 text-[15px] focus:ring-2 focus:outline-none"
                  />
                </div>

                <button
                  type="submit"
                  class="bg-brand text-surface hover:bg-brand-strong focus-visible:ring-brand-ring inline-flex h-12 w-full items-center justify-center rounded-[14px] px-6 text-[15px] font-semibold transition-colors focus:outline-none focus-visible:ring-2"
                >
                  {copy.resendSubmit}
                </button>
              </form>

              <div class="text-ink-muted my-6 flex items-center gap-3 text-xs font-medium">
                <span class="bg-line h-px flex-1" />
                <span>{pagesCopy.or}</span>
                <span class="bg-line h-px flex-1" />
              </div>

              <div class="space-y-3">
                {SOCIAL_AUTH_PROVIDERS.map(({ provider }) => (
                  <form method="POST" action="/api/auth/google" data-provider={provider}>
                    <button
                      type="submit"
                      class="border-line-accent text-brand-deep hover:bg-surface-soft focus-visible:ring-brand-ring bg-surface flex h-12 w-full items-center justify-center gap-3 rounded-[14px] border px-4 text-[15px] font-medium transition-colors focus:outline-none focus-visible:ring-2"
                    >
                      <span class="text-brand border-line-strong flex size-6 items-center justify-center rounded-full border text-sm font-semibold">
                        G
                      </span>
                      {pagesCopy.googleButton}
                    </button>
                  </form>
                ))}
                <a
                  href="/auth/signin"
                  class="border-line-accent text-brand hover:bg-surface-soft focus-visible:ring-brand-ring bg-surface inline-flex h-12 w-full items-center justify-center rounded-[14px] border px-6 text-[15px] font-medium transition-colors focus:outline-none focus-visible:ring-2"
                >
                  {copy.backToSignIn}
                </a>
              </div>
            </>
          )
        }
      </section>
    </main>

    <SiteFooter compact />
  </div>
</Layout>

<script>
  // Adres z rejestracji (albo z poprzedniej próby ponownej wysyłki) czeka w
  // sessionStorage tej karty — nigdy w URL. Bez JS zdanie zostaje ogólne, a
  // pole formularza puste.
  import { bindRememberedAuthEmailForm } from "@/components/auth/remembered-auth-email";

  const form = document.querySelector<HTMLFormElement>("[data-remembered-email-form]");
  const genericSentence = document.querySelector<HTMLElement>("[data-confirm-email-generic]");
  const addressSentence = document.querySelector<HTMLElement>("[data-confirm-email-target]");
  const addressSlot = document.querySelector<HTMLElement>("[data-confirm-email]");

  if (form) {
    const remembered = bindRememberedAuthEmailForm(form, { restore: true });
    // Po błędzie walidacji zapamiętany adres to ten odrzucony — wraca do pola,
    // ale nie do zdania „Wysłaliśmy wiadomość na adres…”.
    const showAddress = form.dataset.hasError !== "true";

    if (remembered && showAddress && genericSentence && addressSentence && addressSlot) {
      addressSlot.textContent = remembered;
      genericSentence.hidden = true;
      addressSentence.hidden = false;
    }
  }
</script>
