---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { SOCIAL_AUTH_PROVIDERS } from "@/lib/auth-providers";

const error = Astro.url.searchParams.get("error");
const shouldRedirectToDashboard = Boolean(Astro.locals.user);

if (shouldRedirectToDashboard) {
  Astro.response.status = 302;
  Astro.response.headers.set("Location", "/dashboard");
}
---

{
  !shouldRedirectToDashboard && (
    <Layout title="Utwórz konto - SafeSpace" lang="pl">
      <main class="flex min-h-screen items-center justify-center bg-[#f4faf7] px-4 py-10 text-[#12201d]">
        <section class="w-full max-w-md rounded-lg border border-[#c8ddd7] bg-white p-6 shadow-[0_22px_60px_rgba(24,78,70,0.12)] sm:p-8">
          <div class="mb-6">
            <a
              href="/"
              class="text-sm font-medium text-[#1f6f65] transition-colors hover:text-[#164e47] hover:underline"
            >
              SafeSpace
            </a>
            <h1 class="mt-3 text-2xl font-semibold text-[#10231f]">Utwórz konto</h1>
            <p class="mt-2 text-sm leading-6 text-[#52645f]">
              Wybierz Google albo konto e-mail i hasło. Ten sam adres użyty wcześniej z Google nie utworzy drugiego
              konta.
            </p>
          </div>

          <div class="space-y-3">
            {SOCIAL_AUTH_PROVIDERS.map((authProvider) => (
              <form method="POST" action="/api/auth/google">
                <button
                  type="submit"
                  class="flex h-11 w-full items-center justify-center gap-3 rounded-lg border border-[#b7d1ca] bg-white px-4 text-sm font-medium text-[#173f39] transition-colors hover:bg-[#eef8f4] focus:ring-2 focus:ring-[#2d8a7d] focus:outline-none"
                >
                  <span class="flex size-6 items-center justify-center rounded-full border border-[#d8e7e2] text-sm font-semibold text-[#1f6f65]">
                    G
                  </span>
                  {authProvider.buttonLabel}
                </button>
              </form>
            ))}
          </div>

          <div class="my-6 flex items-center gap-3 text-xs font-medium text-[#6a7c76]">
            <span class="h-px flex-1 bg-[#d7e5e0]" />
            <span>lub</span>
            <span class="h-px flex-1 bg-[#d7e5e0]" />
          </div>

          <SignUpForm serverError={error} client:load />

          <p class="mt-5 text-center text-sm text-[#52645f]">
            Masz już konto?{" "}
            <a href="/auth/signin" class="font-medium text-[#1f6f65] hover:underline">
              Zaloguj się
            </a>
          </p>
        </section>
      </main>
    </Layout>
  )
}
