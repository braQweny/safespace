---
import AppHeader from "@/components/AppHeader.astro";
import Layout from "@/layouts/Layout.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { getAuthErrorMessageFromSearchParam } from "@/lib/auth-errors";
import { SOCIAL_AUTH_PROVIDERS } from "@/lib/auth-providers";

const error = getAuthErrorMessageFromSearchParam(Astro.url.searchParams.get("error"));
const shouldRedirectToDashboard = Boolean(Astro.locals.user);

if (shouldRedirectToDashboard) {
  Astro.response.status = 302;
  Astro.response.headers.set("Location", "/dashboard");
}
---

{
  !shouldRedirectToDashboard && (
    <Layout title="Utwórz konto - SafeSpace" lang="pl">
      <div class="bg-paper text-ink flex min-h-screen flex-col">
        <AppHeader />

        <main class="flex flex-1 items-center justify-center px-4 py-10">
          <section class="border-line-strong bg-surface shadow-card w-full max-w-md rounded-[20px] border p-6 sm:p-8">
            <div class="mb-6">
              <h1 class="text-ink text-3xl leading-tight">Utwórz konto</h1>
              <p class="text-ink-muted mt-2 text-sm leading-6">
                Wybierz Google albo konto e-mail i hasło. Ten sam adres użyty wcześniej z Google nie utworzy drugiego
                konta.
              </p>
            </div>

            <div class="space-y-3">
              {SOCIAL_AUTH_PROVIDERS.map((authProvider) => (
                <form method="POST" action="/api/auth/google">
                  <button
                    type="submit"
                    class="border-line-accent text-brand-deep hover:bg-surface-soft focus-visible:ring-brand-ring bg-surface flex h-12 w-full items-center justify-center gap-3 rounded-[14px] border px-4 text-[15px] font-medium transition-colors focus:outline-none focus-visible:ring-2"
                  >
                    <span class="text-brand border-line-strong flex size-6 items-center justify-center rounded-full border text-sm font-semibold">
                      G
                    </span>
                    {authProvider.buttonLabel}
                  </button>
                </form>
              ))}
            </div>

            <div class="text-ink-muted my-6 flex items-center gap-3 text-xs font-medium">
              <span class="bg-line h-px flex-1" />
              <span>lub</span>
              <span class="bg-line h-px flex-1" />
            </div>

            <SignUpForm serverError={error} client:load />

            <p class="text-ink-muted mt-5 text-center text-sm">
              Masz już konto?{" "}
              <a href="/auth/signin" class="text-brand font-medium hover:underline">
                Zaloguj się
              </a>
            </p>
          </section>
        </main>

        <SiteFooter compact />
      </div>
    </Layout>
  )
}
