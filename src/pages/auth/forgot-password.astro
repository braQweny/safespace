---
import Layout from "@/layouts/Layout.astro";
import { getAuthErrorMessageFromSearchParam } from "@/lib/auth-errors";

const error = getAuthErrorMessageFromSearchParam(Astro.url.searchParams.get("error"));
const wasSent = Astro.url.searchParams.get("sent") === "1";
---

<Layout title="Zmiana hasła - SafeSpace" lang="pl">
  <main class="flex min-h-screen items-center justify-center bg-[#f4faf7] px-4 py-10 text-[#12201d]">
    <section
      class="w-full max-w-md rounded-lg border border-[#c8ddd7] bg-white p-6 shadow-[0_22px_60px_rgba(24,78,70,0.12)] sm:p-8"
    >
      <div class="mb-6">
        <a href="/" class="text-sm font-medium text-[#1f6f65] transition-colors hover:text-[#164e47] hover:underline">
          SafeSpace
        </a>
        <h1 class="mt-3 text-2xl font-semibold text-[#10231f]">Nie pamiętasz hasła?</h1>
        <p class="mt-2 text-sm leading-6 text-[#52645f]">
          Podaj adres e-mail konta, a wyślemy link do ustawienia nowego hasła.
        </p>
      </div>

      {
        wasSent ? (
          <div
            role="status"
            class="rounded-lg border border-[#bfd8d1] bg-[#f4fbf8] p-4 text-sm leading-6 text-[#173f39]"
          >
            Jeśli ten adres ma konto w SafeSpace, za chwilę dostaniesz wiadomość z linkiem do zmiany hasła. Sprawdź też
            folder ze spamem.
          </div>
        ) : (
          <form method="POST" action="/api/auth/reset-password" class="space-y-4">
            {error ? (
              <p
                role="alert"
                class="rounded-lg border border-[#ecc8c2] bg-[#fdf6f4] p-3 text-sm leading-6 text-[#7c3326]"
              >
                {error}
              </p>
            ) : null}

            <div>
              <label for="email" class="text-sm font-medium text-[#173f39]">
                Adres e-mail
              </label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                class="mt-1 h-11 w-full rounded-lg border border-[#b7d1ca] bg-white px-3 text-sm text-[#12201d] focus:ring-2 focus:ring-[#2d8a7d] focus:outline-none"
              />
            </div>

            <button
              type="submit"
              class="inline-flex h-11 w-full items-center justify-center rounded-lg bg-[#1f6f65] px-5 text-sm font-medium text-white transition-colors hover:bg-[#185950] focus:ring-2 focus:ring-[#2d8a7d] focus:outline-none"
            >
              Wyślij link do zmiany hasła
            </button>
          </form>
        )
      }

      <p class="mt-5 text-center text-sm text-[#52645f]">
        <a href="/auth/signin" class="font-medium text-[#1f6f65] hover:underline"> Wróć do logowania </a>
      </p>
    </section>
  </main>
</Layout>
