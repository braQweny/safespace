---
import AppHeader from "@/components/AppHeader.astro";
import Layout from "@/layouts/Layout.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { getAuthErrorMessageFromSearchParam } from "@/lib/auth-errors";

const error = getAuthErrorMessageFromSearchParam(Astro.url.searchParams.get("error"));
const wasSent = Astro.url.searchParams.get("sent") === "1";
---

<Layout title="Zmiana hasła - SafeSpace" lang="pl">
  <div class="bg-paper text-ink flex min-h-screen flex-col">
    <AppHeader />

    <main class="flex flex-1 items-center justify-center px-4 py-10">
      <section class="border-line-strong bg-surface shadow-card w-full max-w-md rounded-[20px] border p-6 sm:p-8">
        <div class="mb-6">
          <h1 class="text-ink text-3xl leading-tight">Nie pamiętasz hasła?</h1>
          <p class="text-ink-muted mt-2 text-sm leading-6">
            Podaj adres e-mail konta, a wyślemy link do ustawienia nowego hasła.
          </p>
        </div>

        {
          wasSent ? (
            <div
              role="status"
              class="border-brand-soft text-brand-deep bg-brand-tint rounded-2xl border p-4 text-sm leading-6"
            >
              Jeśli ten adres ma konto w SafeSpace, za chwilę dostaniesz wiadomość z linkiem do zmiany hasła. Sprawdź
              też folder ze spamem.
            </div>
          ) : (
            <form
              method="POST"
              action="/api/auth/reset-password"
              class="space-y-4"
              data-remembered-email-form
              data-restore-email={error ? "true" : "false"}
            >
              {error ? (
                <p
                  role="alert"
                  class="border-danger-line bg-danger-soft text-danger rounded-xl border p-3.5 text-sm leading-6"
                >
                  {error}
                </p>
              ) : null}

              <div>
                <label for="email" class="text-brand-deep text-sm font-medium">
                  Adres e-mail
                </label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  class="border-line-strong bg-surface text-ink focus-visible:ring-brand-ring placeholder:text-ink-muted mt-1.5 h-12 w-full rounded-[14px] border px-3.5 text-[15px] focus:ring-2 focus:outline-none"
                />
              </div>

              <button
                type="submit"
                class="bg-brand text-surface hover:bg-brand-strong focus-visible:ring-brand-ring inline-flex h-12 w-full items-center justify-center rounded-[14px] px-6 text-[15px] font-semibold transition-colors focus:outline-none focus-visible:ring-2"
              >
                Wyślij link do zmiany hasła
              </button>
            </form>
          )
        }

        <p class="text-ink-muted mt-5 text-center text-sm">
          <a href="/auth/signin" class="text-brand font-medium hover:underline"> Wróć do logowania </a>
        </p>
      </section>
    </main>

    <SiteFooter compact />
  </div>
</Layout>

<script>
  // Natywny POST + redirect gubi wpisany adres przy błędzie walidacji; adres
  // wraca z sessionStorage (nigdy z URL) i tylko wtedy, gdy strona pokazuje błąd.
  import { bindRememberedAuthEmailForm } from "@/components/auth/remembered-auth-email";

  const form = document.querySelector<HTMLFormElement>("[data-remembered-email-form]");

  if (form) {
    bindRememberedAuthEmailForm(form, { restore: form.dataset.restoreEmail === "true" });
  }
</script>
