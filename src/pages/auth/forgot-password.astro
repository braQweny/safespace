---
import Layout from "@/layouts/Layout.astro";
import { getAuthErrorMessageFromSearchParam } from "@/lib/auth-errors";

const error = getAuthErrorMessageFromSearchParam(Astro.url.searchParams.get("error"));
const wasSent = Astro.url.searchParams.get("sent") === "1";
---

<Layout title="Zmiana hasła - SafeSpace" lang="pl">
  <main class="bg-canvas text-ink flex min-h-screen items-center justify-center px-4 py-10">
    <section
      class="border-line-strong w-full max-w-md rounded-lg border bg-white p-6 shadow-[0_22px_60px_rgba(24,78,70,0.12)] sm:p-8"
    >
      <div class="mb-6">
        <a href="/" class="text-brand hover:text-brand-strong text-sm font-medium transition-colors hover:underline">
          SafeSpace
        </a>
        <h1 class="text-ink mt-3 text-2xl font-semibold">Nie pamiętasz hasła?</h1>
        <p class="text-ink-muted mt-2 text-sm leading-6">
          Podaj adres e-mail konta, a wyślemy link do ustawienia nowego hasła.
        </p>
      </div>

      {
        wasSent ? (
          <div
            role="status"
            class="border-brand-soft text-brand-deep rounded-lg border bg-[#f4fbf8] p-4 text-sm leading-6"
          >
            Jeśli ten adres ma konto w SafeSpace, za chwilę dostaniesz wiadomość z linkiem do zmiany hasła. Sprawdź też
            folder ze spamem.
          </div>
        ) : (
          <form method="POST" action="/api/auth/reset-password" class="space-y-4">
            {error ? (
              <p
                role="alert"
                class="rounded-lg border border-[#ecc8c2] bg-[#fdf6f4] p-3 text-sm leading-6 text-[#7c3326]"
              >
                {error}
              </p>
            ) : null}

            <div>
              <label for="email" class="text-brand-deep text-sm font-medium">
                Adres e-mail
              </label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                class="border-brand-soft text-ink focus:ring-brand-ring mt-1 h-11 w-full rounded-lg border bg-white px-3 text-sm focus:ring-2 focus:outline-none"
              />
            </div>

            <button
              type="submit"
              class="bg-brand hover:bg-brand-strong focus:ring-brand-ring inline-flex h-11 w-full items-center justify-center rounded-lg px-5 text-sm font-medium text-white transition-colors focus:ring-2 focus:outline-none"
            >
              Wyślij link do zmiany hasła
            </button>
          </form>
        )
      }

      <p class="text-ink-muted mt-5 text-center text-sm">
        <a href="/auth/signin" class="text-brand font-medium hover:underline"> Wróć do logowania </a>
      </p>
    </section>
  </main>
</Layout>
