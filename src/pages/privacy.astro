---
import AppHeader from "@/components/AppHeader.astro";
import PrivacyContentEn from "@/components/privacy/PrivacyContentEn.astro";
import PrivacyContentPl from "@/components/privacy/PrivacyContentPl.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import Layout from "@/layouts/Layout.astro";
import { getPrivacyCopy, getVisiblePrivacySectionIds } from "@/lib/page-copy/privacy-copy";
import { isVoiceStartAvailable } from "@/lib/session-flow/voice-start";

// Ta strona opisuje, jak produkt faktycznie działa (co zapisuje, kto to widzi,
// jak usunąć). Jest to jedyne miejsce, do którego prowadzą linki „Prywatność
// i zasady” ze stopki — treść ma być zgodna z architekturą, nie z życzeniem.
// Proza jest w partialu per język; ta powłoka trzyma tylko układ i spis treści.
const locale = Astro.locals.locale;
const copy = getPrivacyCopy(locale);
const { user } = Astro.locals;
const backHref = user ? "/dashboard" : "/";
const backLabel = user ? copy.backToDashboard : copy.backHome;
// Ten sam warunek co w partialach: sekcja o rozmowach głosowych istnieje tylko
// wtedy, gdy panel je oferuje, więc spis treści nie może do niej odsyłać wcześniej.
const sectionIds = getVisiblePrivacySectionIds({ voice: isVoiceStartAvailable() });
---

<Layout title={copy.pageTitle} description={copy.description}>
  <div class="bg-paper text-ink flex min-h-screen flex-col">
    <AppHeader />

    <main class="flex-1 px-4 py-8 sm:px-6 lg:px-8">
      <article class="mx-auto max-w-3xl">
        <p class="text-brand text-sm font-medium">{copy.eyebrow}</p>
        <h1 class="text-ink mt-2 text-4xl leading-tight">{copy.title}</h1>
        <p class="text-ink-soft mt-3 text-base leading-7">{copy.intro}</p>

        <nav aria-label={copy.tocAria} class="border-line bg-surface-soft mt-6 rounded-2xl border p-4">
          <p class="text-ink text-sm font-semibold">{copy.tocTitle}</p>
          <ul class="mt-2 grid gap-1 text-sm sm:grid-cols-2">
            {
              sectionIds.map((sectionId) => (
                <li>
                  <a
                    href={`#${sectionId}`}
                    class="text-brand hover:text-brand-strong focus:ring-brand-ring rounded underline-offset-4 hover:underline focus:ring-2 focus:outline-none"
                  >
                    {copy.sections[sectionId]}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="mt-8 space-y-10 text-base leading-7">
          {locale === "pl" ? <PrivacyContentPl /> : <PrivacyContentEn />}
        </div>

        <div class="mt-10">
          <a
            href={backHref}
            class="border-line-accent bg-surface text-ink hover:bg-surface-hover focus-visible:ring-brand-ring inline-flex h-11 items-center justify-center rounded-full border px-4 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2"
          >
            {backLabel}
          </a>
        </div>
      </article>
    </main>

    <SiteFooter />
  </div>
</Layout>
