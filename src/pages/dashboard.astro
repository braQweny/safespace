---
import AppHeader from "@/components/AppHeader.astro";
import DashboardSessionHistory from "@/components/modality/DashboardSessionHistory";
import SessionStartCard, { AllowanceMeter } from "@/components/session/SessionStartCard";
import SiteFooter from "@/components/SiteFooter.astro";
import Layout from "@/layouts/Layout.astro";
import {
  getModalityByAvatarId,
  MVP_MODALITIES,
  toSelectedModalityAvatar,
  type SelectedModalityAvatar,
} from "@/lib/modalities";
import { logOperationalEvent } from "@/lib/operational-visibility/logger";
import { buildOperationalRequestContext } from "@/lib/operational-visibility/request-context";
import { getSessionDataContext } from "@/lib/session-data/auth";
import { readSessionQuota } from "@/lib/session-data/quota";
import type { SessionQuota } from "@/lib/session-data/types";
import { formatRemainingFreeSessions } from "@/lib/session-flow/plan-copy";
import { SESSION_BOUNDARIES_COPY } from "@/lib/session-copy";
import { readActiveSessionBadge, toActiveSessionBadge } from "@/lib/session-flow/active-session-badge";
import { readCurrentAvatarChoice, type CurrentAvatarChoice } from "@/lib/session-flow/avatar-choice";
import { parseSessionHistoryPage, readSessionHistoryList } from "@/lib/session-flow/session-history";
import type { SessionHistoryListResponse } from "@/lib/session-flow/session-history-contract";
import { formatSessionBudgetMinutes, resolveSessionDurationSeconds } from "@/lib/session-flow/session-budget";
import { readSessionStartPageState, type SessionStartPageState } from "@/lib/session-flow/session-state";
import { getPerspectiveTint } from "@/lib/perspective-tint";
import { getSupportContact } from "@/lib/support-contact";

const avatarUpdated = Astro.url.searchParams.get("avatar") === "updated";
// Historia da się przełączyć na inną perspektywę, więc adres musi tę zmianę
// przeżyć — inaczej odświeżenie cicho wraca do zapisanego awatara.
const viewedModality = getModalityByAvatarId(Astro.url.searchParams.get("historyAvatar"));
const viewedAvatar = viewedModality ? toSelectedModalityAvatar(viewedModality) : null;
const queryPage = parseSessionHistoryPage(Astro.url.searchParams.get("page"));
const initialHistoryPage = queryPage.ok ? queryPage.page : 1;
const operationalContext = await buildOperationalRequestContext(Astro);
const sessionContext = getSessionDataContext(Astro);

let currentAvatarChoice: CurrentAvatarChoice | null = null;
let currentSelection: SelectedModalityAvatar | null = null;
let initialHistory: SessionHistoryListResponse | null = queryPage.ok
  ? null
  : {
      ok: false,
      type: "session_history_error",
      code: queryPage.code,
    };
let choiceFetchFailed = false;

if (sessionContext.ok) {
  const avatarChoice = await readCurrentAvatarChoice(sessionContext.data);

  if (avatarChoice.ok) {
    currentAvatarChoice = avatarChoice.data;
    currentSelection = avatarChoice.data.selected;
    logOperationalEvent(
      {
        event: "avatar.fetch",
        level: "info",
        outcome: "success",
        status: 200,
        provider: "supabase",
      },
      operationalContext,
    );
  } else if (avatarChoice.error.code === "missing_avatar") {
    logOperationalEvent(
      {
        event: "avatar.fetch",
        level: "info",
        outcome: "success",
        status: 200,
        provider: "supabase",
      },
      operationalContext,
    );
  } else {
    choiceFetchFailed = true;
    logOperationalEvent(
      {
        event: "avatar.fetch",
        level: "warn",
        outcome: "failure",
        status: 200,
        reasonCode: avatarChoice.error.code === "invalid_avatar_choice" ? "invalid_choice" : "fetch_failed",
        provider: "supabase",
      },
      operationalContext,
    );
  }
} else {
  choiceFetchFailed = sessionContext.error.code !== "missing_auth";
}

const historyAvatar = viewedAvatar ?? currentSelection;

if (!initialHistory && sessionContext.ok && historyAvatar) {
  initialHistory = await readSessionHistoryList(sessionContext.data, {
    avatar: historyAvatar.avatarId,
    page: String(initialHistoryPage),
  });
}

// Rozmowa zaczyna się tutaj, więc panel czyta ten sam stan startu, z którego
// wcześniej korzystał osobny ekran wstępny. Wiadomości zostają na stronie
// rozmowy — panel potrzebuje tylko stanu i zatwierdzonych podsumowań.
let startPageState: SessionStartPageState | null = null;
let startStateFailed = false;
// Karta pierwszych kroków obiecuje pulę rozmów, zanim jakakolwiek się zacznie,
// więc na tej ścieżce quota jest czytana osobno — stan startu wymaga zapisanej
// perspektywy, a ta jeszcze nie istnieje.
let firstStepsQuota: SessionQuota | null = null;

if (sessionContext.ok && !currentAvatarChoice) {
  const quota = await readSessionQuota(sessionContext.data);

  firstStepsQuota = quota.ok ? quota.data : null;
}

if (sessionContext.ok && currentAvatarChoice) {
  const state = await readSessionStartPageState(sessionContext.data, {
    avatar: currentAvatarChoice,
    includeMessagesForActive: false,
  });

  startPageState = state.ok ? state.data : null;
  startStateFailed = !state.ok;
}

// Rozmowa w toku z zapisaną perspektywą blokuje kartę startu. Rozmowa w toku
// z inną perspektywą (użytkownik zmienił awatara w trakcie) nie może zniknąć z
// nagłówka i panelu — inaczej nie byłoby dokąd wrócić.
const activeSession = startPageState?.kind === "active" ? toActiveSessionBadge(startPageState.session) : null;
const anyActiveSession =
  activeSession ?? (sessionContext.ok ? await readActiveSessionBadge(sessionContext.data) : null);
const otherPerspectiveSession =
  !activeSession && anyActiveSession && anyActiveSession.avatarId !== currentSelection?.avatarId
    ? anyActiveSession
    : null;
const otherPerspectiveName = otherPerspectiveSession?.avatarId
  ? (getModalityByAvatarId(otherPerspectiveSession.avatarId)?.avatarName ?? null)
  : null;
const support = getSupportContact();
// Karta pierwszych kroków pada przed wyborem perspektywy, więc plan bierzemy
// z tej quoty, która na danej ścieżce w ogóle została odczytana.
const sessionBudgetMinutes = formatSessionBudgetMinutes(
  resolveSessionDurationSeconds(startPageState?.sessionQuota?.plan ?? firstStepsQuota?.plan),
);
// Karta startu pokazuje, jak ta perspektywa słucha — zdanie z katalogu, nie z
// zapisanego wyboru (ten niesie tylko identyfikatory i nazwy).
const currentModality = currentSelection ? getModalityByAvatarId(currentSelection.avatarId) : null;
const firstStepsAllowanceCopy = formatRemainingFreeSessions(firstStepsQuota);
const currentTint = currentSelection ? getPerspectiveTint(currentSelection.modalityId) : null;

// Z zapisaną perspektywą panel dzieli się na dwie kolumny: po lewej karta startu
// i granice rozmowy, po prawej historia rozciągnięta na oba wiersze (karta i
// granice same wpadają do lewej kolumny). Drugi wiersz jest `1fr`, żeby wysoka
// historia rozpychała tylko jego, a nie wiersz karty — inaczej między kartą a
// granicami rosłaby pusta przerwa. Bez perspektywy historii nie ma, więc granice
// stoją w wąskiej kolumnie obok karty pierwszych kroków.
const panelGridClass = currentSelection
  ? "lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:grid-rows-[auto_1fr]"
  : "lg:grid-cols-[minmax(0,1fr)_360px]";
---

<Layout title="Panel - SafeSpace" lang="pl">
  <div class="bg-paper text-ink flex min-h-screen flex-col">
    <AppHeader activeSession={anyActiveSession} />

    <main class="flex-1 px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
      <section class="mx-auto max-w-6xl">
        <h1 class="text-ink text-4xl leading-tight">Dzień dobry.</h1>
        <p class="text-ink-muted mt-2 max-w-3xl text-[17px] leading-7">
          Stąd rozpoczniesz rozmowę i wrócisz do jej zapisów.
        </p>

        {
          avatarUpdated ? (
            <div
              class="border-line-accent bg-surface text-brand-deep mt-6 rounded-2xl border p-4 text-sm leading-6"
              role="status"
            >
              Perspektywa została zapisana. Krok 2 z 2: rozpocznij rozmowę poniżej, kiedy będzie na to dobry moment.
            </div>
          ) : null
        }

        {
          choiceFetchFailed ? (
            <div class="border-danger-line bg-danger-soft text-danger mt-6 rounded-2xl border p-4 text-sm leading-6">
              Nie udało się pobrać zapisanej perspektywy. Możesz wrócić do jej wyboru albo spróbować ponownie za chwilę.
            </div>
          ) : null
        }

        <div class:list={["mt-9 grid gap-8 lg:items-start", panelGridClass]}>
          <section class="border-line-strong bg-surface shadow-card rounded-[20px] border p-6 sm:p-8">
            {
              currentSelection ? (
                <div class="flex flex-col">
                  <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:gap-6">
                    <img
                      src={currentSelection.assetPath}
                      alt={currentSelection.altText}
                      width="384"
                      height="384"
                      class="aspect-square w-28 shrink-0 rounded-2xl object-cover sm:w-32"
                      loading="lazy"
                    />
                    <div class="min-w-0">
                      <p class="text-brand text-xs font-semibold tracking-[0.08em] uppercase">
                        Perspektywa na tę rozmowę
                      </p>
                      <h2 class="text-ink mt-1.5 font-serif text-[28px] leading-tight font-medium">
                        {currentSelection.avatarName}
                      </h2>
                      <p class:list={["mt-1 text-[15px] font-medium", currentTint?.text]}>
                        {currentSelection.modalityName}
                      </p>
                      {currentModality ? (
                        <p class="text-ink-soft mt-3 text-base leading-relaxed">{currentModality.explanation}</p>
                      ) : null}
                      <a
                        href="/dashboard/avatar"
                        class="text-brand hover:text-brand-deep focus-visible:ring-brand-ring mt-3 inline-flex rounded text-sm font-medium underline underline-offset-4 transition-colors focus:outline-none focus-visible:ring-2"
                      >
                        Zmień perspektywę
                      </a>
                    </div>
                  </div>

                  {otherPerspectiveSession ? (
                    <div
                      class="bg-brand-tint text-ink-soft mt-6 rounded-2xl p-4 text-sm leading-6"
                      data-other-perspective-session
                    >
                      <p class="text-ink font-semibold">
                        Masz rozmowę w toku
                        {otherPerspectiveName ? ` z perspektywą „${otherPerspectiveName}”` : " z inną perspektywą"}
                      </p>
                      <p class="mt-1">
                        Wróć do niej, zanim zaczniesz nową — trwająca rozmowa nie przerwie się sama, a jej czas płynie.
                      </p>
                      <a
                        href={`/dashboard/session?sessionId=${encodeURIComponent(otherPerspectiveSession.sessionId)}`}
                        class="text-brand hover:text-brand-deep focus-visible:ring-brand-ring mt-2 inline-flex rounded font-medium underline underline-offset-4 focus:outline-none focus-visible:ring-2"
                      >
                        Wróć do rozmowy
                      </a>
                    </div>
                  ) : null}

                  {activeSession ? (
                    <div class="border-line mt-6 border-t pt-5">
                      <p class="text-ink-muted text-sm leading-6">
                        Rozmowa z tą perspektywą jest w toku. Zmiana perspektywy zadziała dopiero od następnej rozmowy.
                      </p>
                      <a
                        href={`/dashboard/session?sessionId=${encodeURIComponent(activeSession.sessionId)}`}
                        class="bg-brand text-surface hover:bg-brand-strong focus-visible:ring-brand-ring mt-4 inline-flex h-12 items-center justify-center rounded-2xl px-6 text-base font-semibold transition-colors focus:outline-none focus-visible:ring-2"
                      >
                        Wróć do rozmowy
                      </a>
                    </div>
                  ) : startPageState ? (
                    <SessionStartCard client:load initialState={startPageState} supportEmail={support.email} />
                  ) : (
                    <p class="text-ink-muted mt-6 text-sm leading-6">
                      {startStateFailed
                        ? "Nie udało się odczytać stanu rozmowy. Odśwież panel za chwilę."
                        : "Rozmowa jest chwilowo niedostępna. Spróbuj ponownie za chwilę."}
                    </p>
                  )}

                  <p class="text-ink-muted mt-6 text-[13px] leading-5">{SESSION_BOUNDARIES_COPY}</p>
                </div>
              ) : (
                <div data-first-steps>
                  <p class="text-brand text-xs font-semibold tracking-[0.08em] uppercase">
                    Dwa kroki do pierwszej rozmowy
                  </p>
                  <h2 class="text-ink mt-1.5 font-serif text-[28px] leading-tight font-medium">
                    Najpierw wybierz, kto ma słuchać
                  </h2>
                  <p class="text-ink-muted mt-2 text-sm leading-6">
                    Pięć awatarów, każdy w innym nurcie psychoterapii. To wybór edukacyjny — nie diagnoza i nie dobór
                    terapii. Zmienisz go przed każdą kolejną rozmową.
                  </p>
                  {/* Twarze przed krokami: pierwszy krok przestaje być abstrakcją. */}
                  <ul class="mt-5 flex flex-wrap gap-4">
                    {MVP_MODALITIES.map((modality) => (
                      <li class="flex w-14 flex-col items-center gap-1.5">
                        <img
                          src={modality.assetPath}
                          alt=""
                          width="384"
                          height="384"
                          loading="lazy"
                          class="h-14 w-14 rounded-full object-cover"
                        />
                        <span class="text-ink-muted text-[13px] leading-4">{modality.avatarName.split(",")[0]}</span>
                      </li>
                    ))}
                  </ul>
                  <ol class="mt-6 grid gap-3 sm:grid-cols-2">
                    <li class="bg-surface-soft flex gap-4 rounded-2xl p-4" aria-current="step">
                      <span class="text-brand shrink-0 font-serif text-2xl leading-none font-medium" aria-hidden="true">
                        1
                      </span>
                      <div class="min-w-0">
                        <p class="text-ink text-[15px] font-semibold">Wybierz perspektywę</p>
                        <p class="text-ink-muted mt-1 text-sm leading-6">
                          Posłuchasz po jednym zdaniu każdej z nich i zaznaczysz tę, która brzmi jak rozmowa, jakiej
                          teraz potrzebujesz.
                        </p>
                      </div>
                    </li>
                    <li class="border-line flex gap-4 rounded-2xl border p-4">
                      <span
                        class="text-ink-muted shrink-0 font-serif text-2xl leading-none font-medium"
                        aria-hidden="true"
                      >
                        2
                      </span>
                      <div class="min-w-0">
                        <p class="text-ink text-[15px] font-semibold">Rozpocznij rozmowę</p>
                        <p class="text-ink-muted mt-1 text-sm leading-6">
                          Po zapisaniu wrócisz tutaj. Rozmowa ruszy dopiero po Twoim kliknięciu i potrwa do{" "}
                          {sessionBudgetMinutes} z widocznym czasem.
                        </p>
                      </div>
                    </li>
                  </ol>
                  <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-5">
                    <a
                      href="/dashboard/avatar"
                      class="bg-brand text-surface hover:bg-brand-strong focus-visible:ring-brand-ring inline-flex h-12 shrink-0 items-center justify-center gap-3 rounded-2xl px-6 text-base font-semibold transition-colors focus:outline-none focus-visible:ring-2"
                    >
                      Wybierz perspektywę
                      <svg
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-4 w-4"
                      >
                        <path d="M5 12h14M13 6l6 6-6 6" />
                      </svg>
                    </a>
                    {firstStepsAllowanceCopy ? (
                      <div class="flex items-center gap-3">
                        <AllowanceMeter quota={firstStepsQuota} />
                        <p class="text-ink-soft text-sm leading-6" data-first-steps-quota>
                          {firstStepsAllowanceCopy}
                        </p>
                      </div>
                    ) : null}
                  </div>
                  <p class="text-ink-muted mt-6 text-[13px] leading-5">{SESSION_BOUNDARIES_COPY}</p>
                </div>
              )
            }
          </section>

          {/* Cichy blok obok karty: numery pod ręką, bez ostrzegawczych kolorów. */}
          <aside class="bg-brand-tint rounded-[20px] p-5 sm:p-6">
            {
              anyActiveSession ? (
                <>
                  <p class="text-brand-deep flex items-center gap-2 text-sm font-semibold">
                    <span aria-hidden="true" class="bg-brand h-2 w-2 rounded-full" />
                    Rozmowa w toku
                  </p>
                  <p class="text-ink-soft mt-2 text-sm leading-6">
                    {anyActiveSession.remainingMinutes
                      ? `Zostało jeszcze około ${anyActiveSession.remainingMinutes} min.`
                      : "Masz otwartą rozmowę z limitem czasu."}
                  </p>
                  <a
                    href={`/dashboard/session?sessionId=${encodeURIComponent(anyActiveSession.sessionId)}`}
                    class="text-brand hover:text-brand-deep focus-visible:ring-brand-ring mt-2 inline-flex rounded text-sm font-medium underline underline-offset-4 focus:outline-none focus-visible:ring-2"
                  >
                    Wróć do rozmowy
                  </a>
                  <div class="border-brand-soft mt-4 border-t pt-4" />
                </>
              ) : null
            }
            <h2 class="text-brand-deep text-[15px] font-semibold">Gdyby działo się coś pilnego</h2>
            <p class="text-ink-soft mt-2 text-sm leading-6">
              Realna pomoc jest zawsze pod ręką: <a href="tel:112" class="text-ink font-semibold">112</a> w nagłym zagrożeniu,
              <a href="tel:800702222" class="text-ink font-semibold">800 70 2222</a> — wsparcie dla dorosłych w kryzysie psychicznym.
            </p>
            <p class="text-ink-muted mt-3 text-[13px] leading-5">
              SafeSpace jest symulacją edukacyjną, nie pomocą kryzysową. W rozmowie przycisk „Pomoc teraz” jest zawsze
              na widoku.
            </p>
          </aside>

          {
            currentSelection ? (
              <DashboardSessionHistory
                client:load
                className="mt-0 lg:col-start-2 lg:row-start-1 lg:row-end-3"
                selectedAvatar={currentSelection}
                initialViewedAvatarId={viewedAvatar?.avatarId ?? null}
                modalities={MVP_MODALITIES}
                initialHistoryPage={initialHistoryPage}
                initialHistory={initialHistory}
              />
            ) : null
          }
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</Layout>
