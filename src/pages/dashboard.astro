---
import Layout from "@/layouts/Layout.astro";

const { user } = Astro.locals;
---

<Layout title="Panel - SafeSpace" lang="pl">
  <main class="min-h-screen bg-[#f4faf7] px-4 py-8 text-[#12201d] sm:px-6 lg:px-8">
    <section class="mx-auto flex min-h-[calc(100vh-64px)] max-w-3xl items-center">
      <div
        class="w-full rounded-lg border border-[#c8ddd7] bg-white p-6 shadow-[0_22px_60px_rgba(24,78,70,0.12)] sm:p-8"
      >
        <p class="text-sm font-medium text-[#1f6f65]">SafeSpace</p>
        <h1 class="mt-3 text-3xl font-semibold text-[#10231f]">Prywatna część produktu</h1>
        <p class="mt-4 text-base leading-7 text-[#38524b]">
          Jesteś zalogowany jako <span class="font-semibold text-[#10231f]">{user?.email}</span>. To bezpieczne wejście
          do kolejnych kroków SafeSpace.
        </p>

        <div class="mt-6 rounded-lg border border-[#d7e5e0] bg-[#f8fcfa] p-4">
          <h2 class="text-base font-semibold text-[#173f39]">Co dalej</h2>
          <p class="mt-2 text-sm leading-6 text-[#52645f]">
            W następnych etapach pojawi się wybór awatara psychoterapeutycznego i pierwsza 15-minutowa sesja. Ten ekran
            jeszcze nie uruchamia rozmowy ani nie zakłada, że sesja jest gotowa.
          </p>
        </div>

        <form method="POST" action="/api/auth/signout" class="mt-6">
          <button
            type="submit"
            class="inline-flex h-11 items-center justify-center rounded-lg border border-[#9cc8bc] bg-white px-5 text-sm font-medium text-[#1f6f65] transition-colors hover:bg-[#eef8f4] focus:ring-2 focus:ring-[#2d8a7d] focus:outline-none"
          >
            Wyloguj się
          </button>
        </form>
      </div>
    </section>
  </main>
</Layout>
