---
import AppHeader from "@/components/AppHeader.astro";
import CrisisRegionList from "@/components/CrisisRegionList.astro";
import DashboardSessionHistory from "@/components/modality/DashboardSessionHistory";
import SessionStartCard, { AllowanceMeter } from "@/components/session/SessionStartCard";
import { parseStartMode, START_MODE_COOKIE } from "@/components/session/start-mode";
import {
  countOwnedDifficultyCards,
  countOwnedPersonCards,
  countOwnedSessionsByAvatar,
  readOwnedTopicMapEnabled,
} from "@/lib/session-data/repository";
import { isPeopleMemoryEnabled } from "@/lib/session-flow/people-memory-mode";
import { isTopicMapEnabled } from "@/lib/session-flow/topic-map-mode";
import SiteFooter from "@/components/SiteFooter.astro";
import Layout from "@/layouts/Layout.astro";
import {
  getModalityByAvatarId,
  MODALITY_CHOICES,
  toSelectedModalityAvatar,
  type SelectedModalityAvatar,
} from "@/lib/modalities";
import { getModalityCopy } from "@/lib/modality-copy";
import { getDashboardCopy } from "@/lib/page-copy/dashboard-copy";
import { logOperationalEvent } from "@/lib/operational-visibility/logger";
import { buildOperationalRequestContext } from "@/lib/operational-visibility/request-context";
import { getSessionDataContext } from "@/lib/session-data/auth";
import { readSessionQuota } from "@/lib/session-data/quota";
import { readVoiceQuota } from "@/lib/session-data/voice-quota";
import type {
  DifficultyCardCounts,
  OwnedSessionCountsByAvatar,
  SessionQuota,
  VoiceQuota,
} from "@/lib/session-data/types";
import { getVoiceMonthlyMinutes } from "@/lib/session-flow/voice-session-mode";
import { isVoiceStartAvailable } from "@/lib/session-flow/voice-start";
import { formatRemainingFreeSessions } from "@/lib/session-flow/plan-copy";
import {
  readActiveSessionBadge,
  toActiveSessionBadge,
  type ActiveSessionBadge,
} from "@/lib/session-flow/active-session-badge";
import { readCurrentAvatarChoice, type CurrentAvatarChoice } from "@/lib/session-flow/avatar-choice";
import { parseSessionHistoryPage, readSessionHistoryList } from "@/lib/session-flow/session-history";
import type { SessionHistoryListResponse } from "@/lib/session-flow/session-history-contract";
import { formatSessionBudgetMinutes, resolveSessionDurationSeconds } from "@/lib/session-flow/session-budget";
import { readSessionStartPageState, type SessionStartPageState } from "@/lib/session-flow/session-state";
import { getPerspectiveTint } from "@/lib/perspective-tint";
import type { ModalityId } from "@/lib/modality-catalog";
import { getSupportContact } from "@/lib/support-contact";
import { isBillingEnabled } from "@/lib/billing/config";

const locale = Astro.locals.locale;
const copy = getDashboardCopy(locale);
const avatarUpdated = Astro.url.searchParams.get("avatar") === "updated";
// Historia da się przełączyć na inną perspektywę, więc adres musi tę zmianę
// przeżyć — inaczej odświeżenie cicho wraca do zapisanego awatara.
const viewedModality = getModalityByAvatarId(Astro.url.searchParams.get("historyAvatar"));
const viewedAvatar = viewedModality ? toSelectedModalityAvatar(viewedModality) : null;
const queryPage = parseSessionHistoryPage(Astro.url.searchParams.get("page"));
const initialHistoryPage = queryPage.ok ? queryPage.page : 1;
// Link z zakończonej rozmowy prowadzi tu z `?session=`, a historia ma tę
// rozmowę sama otworzyć. Wtedy wyspa nie może czekać, aż ktoś do niej
// przewinie (na telefonie stoi pod kartą startu) — hydratuje się od razu.
// Bez takiego linku wystarczy hydratacja, gdy sekcja wejdzie w kadr.
const requestsHistorySession = (Astro.url.searchParams.get("session") ?? "").length > 0;
const sessionContext = getSessionDataContext(Astro);

let currentAvatarChoice: CurrentAvatarChoice | null = null;
let currentSelection: SelectedModalityAvatar | null = null;
let initialHistory: SessionHistoryListResponse | null = queryPage.ok
  ? null
  : {
      ok: false,
      type: "session_history_error",
      code: queryPage.code,
    };
let choiceFetchFailed = false;

// Kontekst logów (hash użytkownika) i zapisana perspektywa nie zależą od
// siebie, więc idą równolegle zamiast jedno po drugim.
const [operationalContext, avatarChoice] = await Promise.all([
  buildOperationalRequestContext(Astro),
  sessionContext.ok ? readCurrentAvatarChoice(sessionContext.data) : null,
]);

if (!sessionContext.ok) {
  choiceFetchFailed = sessionContext.error.code !== "missing_auth";
} else if (avatarChoice) {
  if (avatarChoice.ok) {
    currentAvatarChoice = avatarChoice.data;
    currentSelection = avatarChoice.data.selected;
    logOperationalEvent(
      {
        event: "avatar.fetch",
        level: "info",
        outcome: "success",
        status: 200,
        provider: "supabase",
      },
      operationalContext,
    );
  } else if (avatarChoice.error.code === "missing_avatar") {
    logOperationalEvent(
      {
        event: "avatar.fetch",
        level: "info",
        outcome: "success",
        status: 200,
        provider: "supabase",
      },
      operationalContext,
    );
  } else {
    choiceFetchFailed = true;
    logOperationalEvent(
      {
        event: "avatar.fetch",
        level: "warn",
        outcome: "failure",
        status: 200,
        reasonCode: avatarChoice.error.code === "invalid_avatar_choice" ? "invalid_choice" : "fetch_failed",
        provider: "supabase",
      },
      operationalContext,
    );
  }
}

const historyAvatar = viewedAvatar ?? currentSelection;

// Rozmowa zaczyna się tutaj, więc panel czyta ten sam stan startu, z którego
// wcześniej korzystał osobny ekran wstępny. Wiadomości zostają na stronie
// rozmowy — panel potrzebuje tylko stanu startu.
let startPageState: SessionStartPageState | null = null;
let startStateFailed = false;
// Karta pierwszych kroków obiecuje pulę rozmów, zanim jakakolwiek się zacznie,
// więc na tej ścieżce quota jest czytana osobno — stan startu wymaga zapisanej
// perspektywy, a ta jeszcze nie istnieje.
let firstStepsQuota: SessionQuota | null = null;
// Rozmowa w toku z dowolną perspektywą — dla pigułki w nagłówku.
let anyOwnedActiveSession: ActiveSessionBadge | null = null;
// Ile rozmów stoi za każdą twarzą: filtr historii pokazuje tylko te z zapisami.
let sessionCountsByAvatar: OwnedSessionCountsByAvatar | null = null;
// Liczby kart osób i tematów zapisanej perspektywy dla wiersza-skrótu „Co Lena
// pamięta”: same liczby, bez kart — karty żyją w `/dashboard/memory`.
// `null` = odczyt padł, nie „brak kart”.
const peopleMemoryMode = isPeopleMemoryEnabled();
let personCardCount: number | null = null;
const topicMapMode = isTopicMapEnabled();
let difficultyCounts: DifficultyCardCounts | null = null;
let topicMapEnabled = true;
// Pula rozmów głosowych (próba free / minuty premium) tylko przy włączonej
// fladze i bezpośrednim OpenAI; `null` = brak przycisku głosowego na karcie.
const voiceStartAvailable = isVoiceStartAvailable();
let voiceQuota: VoiceQuota | null = null;
// Ostatni wybór „Pisana | Głosowa” z ciasteczka: karta renderuje go od razu,
// zamiast przeskakiwać na niego po hydratacji. Wartość nie trafia do logów.
const initialStartMode = parseStartMode(Astro.cookies.get(START_MODE_COOKIE)?.value);

if (sessionContext.ok) {
  // Po poznaniu perspektywy żaden z tych odczytów nie zależy od pozostałych,
  // więc zamiast kilku rund do bazy po kolei jest jedna. Znaczek rozmowy w
  // toku jest czytany zawsze: gdy stan startu sam ją niesie, wynik i tak
  // zostanie nadpisany, ale czekanie na ten stan kosztowałoby osobną rundę.
  const [
    historyResult,
    quotaResult,
    startStateResult,
    activeBadge,
    avatarCounts,
    personCountResult,
    difficultyCountsResult,
    topicPreference,
    voiceQuotaResult,
  ] = await Promise.all([
    !initialHistory && historyAvatar
      ? readSessionHistoryList(sessionContext.data, {
          avatar: historyAvatar.avatarId,
          page: String(initialHistoryPage),
        })
      : null,
    currentAvatarChoice ? null : readSessionQuota(sessionContext.data),
    currentAvatarChoice
      ? readSessionStartPageState(sessionContext.data, {
          avatar: currentAvatarChoice,
          includeMessagesForActive: false,
        })
      : null,
    readActiveSessionBadge(sessionContext.data),
    currentAvatarChoice ? countOwnedSessionsByAvatar(sessionContext.data) : null,
    currentAvatarChoice && peopleMemoryMode
      ? countOwnedPersonCards(sessionContext.data, currentAvatarChoice.selected.avatarId)
      : null,
    currentAvatarChoice && topicMapMode
      ? countOwnedDifficultyCards(sessionContext.data, currentAvatarChoice.selected.avatarId)
      : null,
    currentAvatarChoice && topicMapMode ? readOwnedTopicMapEnabled(sessionContext.data) : null,
    currentAvatarChoice && voiceStartAvailable
      ? readVoiceQuota(sessionContext.data, { limitMinutes: getVoiceMonthlyMinutes() })
      : null,
  ]);

  // Nieudany odczyt puli chowa tylko przycisk głosowy; start tekstowy zostaje.
  voiceQuota = voiceQuotaResult?.ok ? voiceQuotaResult.data : null;

  if (historyResult) {
    initialHistory = historyResult;
  }

  if (personCountResult) {
    personCardCount = personCountResult.ok ? personCountResult.data : null;
  }

  if (difficultyCountsResult) {
    difficultyCounts = difficultyCountsResult.ok ? difficultyCountsResult.data : null;
  }

  // Nieudany odczyt preferencji nie chowa licznika „do potwierdzenia”: domyślnie włączona.
  topicMapEnabled = topicPreference?.ok ? topicPreference.data : true;

  if (quotaResult) {
    firstStepsQuota = quotaResult.ok ? quotaResult.data : null;
  }

  if (startStateResult) {
    startPageState = startStateResult.ok ? startStateResult.data : null;
    startStateFailed = !startStateResult.ok;
  }

  anyOwnedActiveSession = activeBadge;
  // Nieudany odczyt liczb nie zabiera historii — filtr wraca do pełnej piątki.
  sessionCountsByAvatar = avatarCounts?.ok ? avatarCounts.data : null;
}

// Rozmowa w toku z zapisaną perspektywą blokuje kartę startu. Rozmowa w toku
// z inną perspektywą (użytkownik zmienił awatara w trakcie) nie może zniknąć z
// nagłówka i panelu — inaczej nie byłoby dokąd wrócić.
const activeSession = startPageState?.kind === "active" ? toActiveSessionBadge(startPageState.session) : null;
const anyActiveSession = activeSession ?? anyOwnedActiveSession;
const otherPerspectiveSession =
  !activeSession && anyActiveSession && anyActiveSession.avatarId !== currentSelection?.avatarId
    ? anyActiveSession
    : null;
const otherPerspectiveModality = otherPerspectiveSession?.avatarId
  ? getModalityByAvatarId(otherPerspectiveSession.avatarId)
  : null;
const otherPerspectiveName = otherPerspectiveModality
  ? getModalityCopy(locale, otherPerspectiveModality.modalityId).avatarName
  : null;
const support = getSupportContact();
// Karta pierwszych kroków pada przed wyborem perspektywy, więc plan bierzemy
// z tej quoty, która na danej ścieżce w ogóle została odczytana.
const sessionBudgetMinutes = formatSessionBudgetMinutes(
  locale,
  resolveSessionDurationSeconds(startPageState?.sessionQuota?.plan ?? firstStepsQuota?.plan),
);
const firstStepsAllowanceCopy = formatRemainingFreeSessions(locale, firstStepsQuota);
const currentTint = currentSelection ? getPerspectiveTint(currentSelection.modalityId) : null;
const currentFirstName = currentSelection?.avatarFirstName ?? null;
const currentCopy = currentSelection ? getModalityCopy(locale, currentSelection.modalityId) : null;
// Pierwsza rozmowa z jednej karty: twarze są zwykłym formularzem wyboru
// (`POST /api/profile/avatar` z intencją `save_and_start` → `/dashboard?start=now`),
// więc działa bez JS. Który opis i które imię w przycisku widać, rozstrzyga CSS
// (`:has(:checked)`); klasy stoją w całości, bo Tailwind musi je zobaczyć w
// źródle. Domyślnie Iga — jej opis sam mówi, że jest dobrym pierwszym wyborem.
const FIRST_PICK_DEFAULT: ModalityId = "integrative";
const FIRST_PICK_SHOW_BLOCK: Record<ModalityId, string> = {
  psychodynamic: "group-has-[#first-pick-psychodynamic:checked]:block",
  cbt: "group-has-[#first-pick-cbt:checked]:block",
  humanistic_experiential: "group-has-[#first-pick-humanistic_experiential:checked]:block",
  systemic: "group-has-[#first-pick-systemic:checked]:block",
  integrative: "group-has-[#first-pick-integrative:checked]:block",
};
const FIRST_PICK_SHOW_INLINE: Record<ModalityId, string> = {
  psychodynamic: "group-has-[#first-pick-psychodynamic:checked]:inline",
  cbt: "group-has-[#first-pick-cbt:checked]:inline",
  humanistic_experiential: "group-has-[#first-pick-humanistic_experiential:checked]:inline",
  systemic: "group-has-[#first-pick-systemic:checked]:inline",
  integrative: "group-has-[#first-pick-integrative:checked]:inline",
};
const firstPicks = MODALITY_CHOICES.map((modality) => ({
  modality,
  modalityCopy: getModalityCopy(locale, modality.modalityId),
  tint: getPerspectiveTint(modality.modalityId),
}));
// Zdanie „po co jest panel” tylko przed pierwszą rozmową: osoba po dwudziestu
// rozmowach nie potrzebuje go czytać za każdym razem.
const showsIntro = currentSelection === null || (startPageState?.sessionQuota?.usedSessions ?? 0) === 0;
// Wiersz-skrót „Co Lena pamięta”: liczby zamiast dwóch sekcji z wstępami; same
// karty, mapa i podsumowanie stoją w `/dashboard/memory`. Bez flag zostaje
// podsumowanie, więc skrót jest zawsze przy zapisanej perspektywie.
const memoryPeopleCount = peopleMemoryMode ? (personCardCount ?? 0) : null;
const memoryTopicCount = topicMapMode ? (difficultyCounts?.cards ?? 0) : null;
const memoryPendingCount = topicMapMode && topicMapEnabled && difficultyCounts ? difficultyCounts.pendingLinks : 0;
const memoryCounts = [
  memoryPeopleCount !== null ? copy.memoryPeopleCount(memoryPeopleCount) : null,
  memoryTopicCount !== null ? copy.memoryTopicCount(memoryTopicCount) : null,
].filter((entry): entry is string => entry !== null);
const memoryMeta =
  memoryPeopleCount === null && memoryTopicCount === null
    ? copy.memorySummaryOnly
    : (memoryPeopleCount ?? 0) + (memoryTopicCount ?? 0) === 0
      ? copy.memoryEmpty
      : memoryCounts.join(" · ");

// Z zapisaną perspektywą panel dzieli się na dwie kolumny: po lewej karta startu
// i blok pomocy, po prawej historia rozciągnięta na oba wiersze. Drugi wiersz
// jest `1fr`, żeby wysoka historia rozpychała tylko jego, a nie wiersz karty —
// inaczej między kartą a pomocą rosłaby pusta przerwa. Bez perspektywy historii
// nie ma, więc pomoc stoi w wąskiej kolumnie obok karty pierwszych kroków.
const panelGridClass = currentSelection
  ? "lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:grid-rows-[auto_1fr]"
  : "lg:grid-cols-[minmax(0,1fr)_360px]";
// Jeden zestaw propsów dla obu wariantów hydratacji historii (patrz
// `requestsHistorySession`), żeby nie rozjechały się przy edycji.
const historyProps = currentSelection
  ? {
      locale,
      timeZone: Astro.locals.timeZone,
      className: "mt-0 lg:col-start-2 lg:row-start-1 lg:row-end-3",
      selectedAvatar: currentSelection,
      initialViewedAvatarId: viewedAvatar?.avatarId ?? null,
      modalities: MODALITY_CHOICES,
      initialHistoryPage,
      initialHistory,
      sessionCountsByAvatar,
    }
  : null;
---

<Layout title={copy.pageTitle}>
  <div class="bg-paper text-ink flex min-h-screen flex-col">
    <AppHeader activeSession={anyActiveSession} />

    <main class="flex-1 px-4 py-6 sm:px-6 sm:py-10 lg:px-8">
      <section class="mx-auto max-w-6xl">
        <h1 class="text-ink text-4xl leading-tight">{copy.greeting}</h1>
        {showsIntro ? <p class="text-ink-muted mt-2 max-w-3xl text-[17px] leading-7">{copy.intro}</p> : null}

        {
          avatarUpdated ? (
            <div
              class="border-line-accent bg-surface text-brand-deep mt-6 rounded-2xl border p-4 text-sm leading-6"
              role="status"
            >
              {copy.avatarUpdated}
            </div>
          ) : null
        }

        {
          choiceFetchFailed ? (
            <div class="border-danger-line bg-danger-soft text-danger mt-6 rounded-2xl border p-4 text-sm leading-6">
              {copy.choiceFetchFailed}
            </div>
          ) : null
        }

        <div class:list={["mt-6 grid gap-6 lg:items-start", panelGridClass]}>
          <section class="border-line-strong bg-surface shadow-card rounded-[20px] border p-5 sm:p-7">
            {
              currentSelection ? (
                <div class="flex flex-col">
                  <div class="flex items-center gap-4">
                    <img
                      src={currentSelection.assetPath}
                      alt=""
                      width="256"
                      height="256"
                      class="h-16 w-16 shrink-0 rounded-full object-cover sm:h-20 sm:w-20"
                      loading="eager"
                      decoding="async"
                    />
                    <div class="min-w-0">
                      <h2 class="text-ink font-serif text-[28px] leading-tight font-medium">
                        {currentSelection.avatarFirstName}
                      </h2>
                      <p class:list={["mt-1 text-[15px] font-medium", currentTint?.text]}>
                        {currentCopy?.perspectiveFocus}
                      </p>
                      <a
                        href="/dashboard/avatar"
                        class="text-brand hover:text-brand-deep focus-visible:ring-brand-ring inline-flex min-h-11 items-center rounded text-sm font-medium underline underline-offset-4 transition-colors focus:outline-none focus-visible:ring-2"
                      >
                        {copy.changePerspective}
                      </a>
                    </div>
                  </div>

                  {otherPerspectiveSession ? (
                    <div
                      class="bg-brand-tint text-ink-soft mt-6 rounded-2xl p-4 text-sm leading-6"
                      data-other-perspective-session
                    >
                      <p class="text-ink font-semibold">{copy.otherSessionTitle(otherPerspectiveName)}</p>
                      <p class="mt-1">{copy.otherSessionBody}</p>
                      <a
                        href={`/dashboard/session?sessionId=${encodeURIComponent(otherPerspectiveSession.sessionId)}`}
                        class="text-brand hover:text-brand-deep focus-visible:ring-brand-ring mt-2 inline-flex rounded font-medium underline underline-offset-4 focus:outline-none focus-visible:ring-2"
                      >
                        {copy.backToConversation}
                      </a>
                    </div>
                  ) : null}

                  {activeSession ? (
                    <div class="border-line mt-6 border-t pt-5">
                      <p class="text-ink-muted text-sm leading-6">{copy.activeWithThisPerspective}</p>
                      <a
                        href={`/dashboard/session?sessionId=${encodeURIComponent(activeSession.sessionId)}`}
                        class="bg-brand text-surface hover:bg-brand-strong focus-visible:ring-brand-ring mt-4 inline-flex h-12 items-center justify-center rounded-[14px] px-6 text-base font-semibold transition-colors focus:outline-none focus-visible:ring-2"
                      >
                        {copy.backToConversation}
                      </a>
                    </div>
                  ) : startPageState ? (
                    <SessionStartCard
                      client:load
                      locale={locale}
                      initialState={startPageState}
                      supportEmail={support.email}
                      billingEnabled={isBillingEnabled()}
                      voiceQuota={voiceQuota}
                      initialMode={initialStartMode}
                    />
                  ) : (
                    <p class="text-ink-muted mt-6 text-sm leading-6">
                      {startStateFailed ? copy.startStateFailed : copy.startUnavailable}
                    </p>
                  )}

                  {/* Granice rozmowy nie stoją już tutaj: są w stopce tej strony i pod
                      polem pisania w rozmowie. Trzecia kopia na jednym ekranie była szumem.
                      Osoby, tematy i podsumowanie mają własny widok — tu tylko liczby. */}
                  <a
                    href="/dashboard/memory"
                    class="bg-surface-soft text-ink hover:bg-surface-hover focus-visible:ring-brand-ring mt-5 flex min-h-14 items-center gap-3 rounded-2xl px-4 py-3 transition-colors focus:outline-none focus-visible:ring-2"
                    data-memory-shortcut
                  >
                    <svg
                      width="22"
                      height="22"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                      class="h-[22px] w-[22px] shrink-0"
                    >
                      <path
                        d="M4.5 21.5V12a7.5 7.5 0 0 1 15 0v9.5Z"
                        class="fill-brand-soft stroke-brand"
                        stroke-width="1.75"
                        stroke-linejoin="round"
                      />
                    </svg>
                    <span class="min-w-0 flex-1">
                      <span class="block text-[15px] leading-6 font-semibold">
                        {copy.memoryShortcut(currentFirstName ?? "")}
                      </span>
                      <span class="text-ink-muted block text-[13px] leading-5">
                        {memoryMeta}
                        {memoryPendingCount > 0 ? (
                          <>
                            {" · "}
                            <span class="text-brand-deep font-semibold">
                              {copy.memoryPendingCount(memoryPendingCount)}
                            </span>
                          </>
                        ) : null}
                      </span>
                    </span>
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="text-ink-muted h-4 w-4 shrink-0"
                    >
                      <path d="m9 6 6 6-6 6" />
                    </svg>
                  </a>
                </div>
              ) : (
                <form method="post" action="/api/profile/avatar" class="group" data-first-steps>
                  <input type="hidden" name="intent" value="save_and_start" />
                  <h2 class="text-ink font-serif text-[28px] leading-tight font-medium">{copy.firstStepsTitle}</h2>
                  <p class="text-ink-muted mt-2 text-sm leading-6">{copy.firstStepsBody}</p>
                  <fieldset class="mt-5 min-w-0 border-0 p-0">
                    <legend class="sr-only">{copy.firstStepsLegend}</legend>
                    <div class="flex justify-between gap-y-3 sm:justify-start sm:gap-x-5">
                      {firstPicks.map(({ modality }) => (
                        <label class="flex w-14 cursor-pointer flex-col items-center gap-1.5">
                          <input
                            type="radio"
                            name="modalityId"
                            value={modality.modalityId}
                            id={`first-pick-${modality.modalityId}`}
                            checked={modality.modalityId === FIRST_PICK_DEFAULT}
                            class="peer sr-only"
                          />
                          <img
                            src={modality.assetPath}
                            alt=""
                            width="256"
                            height="256"
                            loading="eager"
                            decoding="async"
                            class="ring-offset-surface peer-checked:ring-brand peer-focus-visible:ring-brand-ring h-12 w-12 rounded-full object-cover opacity-80 ring-offset-2 transition peer-checked:opacity-100 peer-checked:ring-2 peer-focus-visible:ring-2"
                          />
                          <span class="text-ink-muted peer-checked:text-brand-deep text-[13px] leading-4 peer-checked:font-semibold">
                            {modality.avatarFirstName}
                          </span>
                        </label>
                      ))}
                    </div>
                  </fieldset>
                  <div class="bg-surface-soft mt-4 rounded-2xl px-4 pt-4 pb-1">
                    {firstPicks.map(({ modality, modalityCopy, tint }) => (
                      <div
                        class:list={["hidden", FIRST_PICK_SHOW_BLOCK[modality.modalityId]]}
                        data-first-pick-detail={modality.modalityId}
                      >
                        <p class="text-[15px] leading-6">
                          <span class="text-ink font-semibold">{modality.avatarFirstName}</span>
                          {" · "}
                          <span class:list={["font-medium", tint.text]}>{modalityCopy.perspectiveFocus}</span>
                        </p>
                        <p class="text-ink mt-1 font-serif text-lg leading-snug italic">
                          {copy.quote(modalityCopy.voiceSample)}
                        </p>
                        {modality.modalityId === FIRST_PICK_DEFAULT ? (
                          <p class="text-ink-muted mt-1 text-sm leading-6">{copy.firstStepsDefaultHint}</p>
                        ) : null}
                      </div>
                    ))}
                    <a
                      href="/dashboard/avatar"
                      class="text-brand hover:text-brand-deep focus-visible:ring-brand-ring inline-flex min-h-11 items-center rounded text-sm font-medium underline underline-offset-4 transition-colors focus:outline-none focus-visible:ring-2"
                    >
                      {copy.comparePerspectives}
                    </a>
                  </div>
                  <button
                    type="submit"
                    class="bg-brand text-surface hover:bg-brand-strong focus-visible:ring-brand-ring mt-5 inline-flex min-h-12 w-full items-center justify-center gap-3 rounded-[14px] px-6 py-3 text-base font-semibold transition-colors focus:outline-none focus-visible:ring-2 sm:w-auto"
                  >
                    {/* Bez `:has` (stara przeglądarka) zostaje ogólny napis. */}
                    <span class="group-has-[:checked]:hidden">{copy.startGeneric}</span>
                    {firstPicks.map(({ modality, modalityCopy }) => (
                      <span class:list={["hidden", FIRST_PICK_SHOW_INLINE[modality.modalityId]]}>
                        {copy.startWith(modalityCopy.withAvatar)}
                      </span>
                    ))}
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="h-4 w-4"
                    >
                      <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </button>
                  {firstStepsAllowanceCopy ? (
                    <div class="mt-4 flex items-center gap-3">
                      <AllowanceMeter quota={firstStepsQuota} />
                      <p class="text-ink-soft text-sm leading-6" data-first-steps-quota>
                        {firstStepsAllowanceCopy}
                      </p>
                    </div>
                  ) : null}
                  <p class="text-ink-muted mt-3 text-sm leading-6">{copy.budgetNote(sessionBudgetMinutes)}</p>
                </form>
              )
            }
          </section>

          {
            /*
            Historia przed blokiem pomocy: na telefonie kolejność źródła jest
            kolejnością ekranu, a osoba wracająca po wczorajszy zapis nie powinna
            przewijać dwóch ekranów. Na monitorze siatka i tak stawia historię w
            prawej kolumnie, a blok pomocy pod kartą. Osoby i tematy nie stoją
            już tutaj: panel to start i historia, reszta jest w widoku pamięci.
          */
          }
          {
            historyProps ? (
              requestsHistorySession ? (
                <DashboardSessionHistory client:load {...historyProps} />
              ) : (
                <DashboardSessionHistory client:visible {...historyProps} />
              )
            ) : null
          }

          {
            /* Cichy blok pod kartą: same numery, bez ostrzegawczych kolorów i bez
              zegara rozmowy w toku — o niej mówią pigułka w nagłówku i karta startu.
              Zastrzeżenie o symulacji zostaje w stopce, żeby na ekranie padało raz. */
          }
          <aside
            class:list={[
              "bg-brand-tint rounded-[20px] p-5 sm:p-6",
              currentSelection && "lg:col-start-1 lg:row-start-2",
            ]}
          >
            <h2 class="text-brand-deep text-[15px] font-semibold">{copy.helpTitle}</h2>
            {
              /* Te same trzy regiony co w panelu „Pomoc teraz”: aplikacja nie zna
                kraju osoby, więc po angielsku nie może pokazywać wyłącznie polskich numerów. */
            }
            <CrisisRegionList class="mt-3" />
          </aside>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</Layout>
