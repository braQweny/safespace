---
import Layout from "@/layouts/Layout.astro";
import { logOperationalEvent } from "@/lib/operational-visibility/logger";
import { buildOperationalRequestContext } from "@/lib/operational-visibility/request-context";
import { getSessionDataContext } from "@/lib/session-data/auth";
import { readCurrentAvatarChoice } from "@/lib/session-flow/avatar-choice";

const { user } = Astro.locals;
const avatarUpdated = Astro.url.searchParams.get("avatar") === "updated";
const operationalContext = await buildOperationalRequestContext(Astro);
const sessionContext = getSessionDataContext(Astro);

let currentSelection = null;
let choiceFetchFailed = false;

if (sessionContext.ok) {
  const avatarChoice = await readCurrentAvatarChoice(sessionContext.data);

  if (avatarChoice.ok) {
    currentSelection = avatarChoice.data.selected;
    logOperationalEvent(
      {
        event: "avatar.fetch",
        level: "info",
        outcome: "success",
        status: 200,
        provider: "supabase",
      },
      operationalContext,
    );
  } else if (avatarChoice.error.code === "missing_avatar") {
    logOperationalEvent(
      {
        event: "avatar.fetch",
        level: "info",
        outcome: "success",
        status: 200,
        provider: "supabase",
      },
      operationalContext,
    );
  } else {
    choiceFetchFailed = true;
    logOperationalEvent(
      {
        event: "avatar.fetch",
        level: "warn",
        outcome: "failure",
        status: 200,
        reasonCode: avatarChoice.error.code === "invalid_avatar_choice" ? "invalid_choice" : "fetch_failed",
        provider: "supabase",
      },
      operationalContext,
    );
  }
} else {
  choiceFetchFailed = sessionContext.error.code !== "missing_auth";
}
---

<Layout title="Panel - SafeSpace" lang="pl">
  <main class="min-h-screen bg-[#f4faf7] px-4 py-8 text-[#12201d] sm:px-6 lg:px-8">
    <section class="mx-auto max-w-5xl">
      <p class="text-sm font-medium text-[#1f6f65]">SafeSpace</p>
      <h1 class="mt-3 text-3xl font-semibold text-[#10231f]">Prywatna część produktu</h1>
      <p class="mt-4 max-w-3xl text-base leading-7 text-[#38524b]">
        Jesteś zalogowany jako <span class="font-semibold text-[#10231f]">{user?.email}</span>. To bezpieczne wejście do
        kolejnych kroków SafeSpace.
      </p>

      {
        avatarUpdated ? (
          <div class="mt-6 rounded-lg border border-[#b9d7cf] bg-white p-4 text-sm leading-6 text-[#1f6f65]">
            Wybór awatara został zapisany.
          </div>
        ) : null
      }

      {
        choiceFetchFailed ? (
          <div class="mt-6 rounded-lg border border-[#f0c7c7] bg-[#fff8f8] p-4 text-sm leading-6 text-[#7d2d2d]">
            Nie udało się pobrać zapisanego wyboru. Możesz wrócić do wyboru awatara albo spróbować ponownie za chwilę.
          </div>
        ) : null
      }

      <div class="mt-8 grid gap-5 lg:grid-cols-[minmax(0,1fr)_320px]">
        <section class="rounded-lg border border-[#c8ddd7] bg-white p-6 shadow-[0_22px_60px_rgba(24,78,70,0.12)]">
          {
            currentSelection ? (
              <div class="grid gap-5 sm:grid-cols-[160px_minmax(0,1fr)] sm:items-center">
                <img
                  src={currentSelection.assetPath}
                  alt={currentSelection.altText}
                  width="384"
                  height="384"
                  class="aspect-square w-full max-w-40 rounded-lg object-cover"
                  loading="lazy"
                />
                <div>
                  <p class="text-sm font-medium text-[#1f6f65]">Wybrany awatar</p>
                  <h2 class="mt-2 text-2xl font-semibold text-[#10231f]">{currentSelection.avatarName}</h2>
                  <p class="mt-2 text-base font-medium text-[#1f6f65]">{currentSelection.modalityName}</p>
                  <p class="mt-4 text-sm leading-6 text-[#52645f]">
                    Ten wybór będzie zapisany przy pierwszej 15-minutowej sesji. Samo wejście na stronę sesji nie zużywa
                    darmowej próby.
                  </p>
                  <div class="mt-5 flex flex-col gap-3 sm:flex-row">
                    <a
                      href="/dashboard/session"
                      class="inline-flex h-11 items-center justify-center rounded-lg bg-[#1f6f65] px-5 text-sm font-medium text-white transition-colors hover:bg-[#185950] focus:ring-2 focus:ring-[#2d8a7d] focus:outline-none"
                    >
                      Przejdź do sesji
                    </a>
                    <a
                      href="/dashboard/avatar"
                      class="inline-flex h-11 items-center justify-center rounded-lg border border-[#9cc8bc] bg-white px-5 text-sm font-medium text-[#1f6f65] transition-colors hover:bg-[#eef8f4] focus:ring-2 focus:ring-[#2d8a7d] focus:outline-none"
                    >
                      Zmień awatara
                    </a>
                  </div>
                </div>
              </div>
            ) : (
              <div>
                <p class="text-sm font-medium text-[#1f6f65]">Następny krok</p>
                <h2 class="mt-2 text-2xl font-semibold text-[#10231f]">Wybierz awatara przed pierwszą sesją</h2>
                <p class="mt-4 text-sm leading-6 text-[#52645f]">
                  Awatar reprezentuje edukacyjną perspektywę przyszłej symulacji rozmowy. Wybór nie uruchamia jeszcze
                  sesji ani nie zastępuje konsultacji ze specjalistą.
                </p>
                <a
                  href="/dashboard/avatar"
                  class="mt-5 inline-flex h-11 items-center justify-center rounded-lg bg-[#1f6f65] px-5 text-sm font-medium text-white transition-colors hover:bg-[#185950] focus:ring-2 focus:ring-[#2d8a7d] focus:outline-none"
                >
                  Wybierz awatara
                </a>
              </div>
            )
          }
        </section>

        <aside class="rounded-lg border border-[#d7e5e0] bg-[#f8fcfa] p-5">
          <h2 class="text-base font-semibold text-[#173f39]">Co dalej</h2>
          <p class="mt-2 text-sm leading-6 text-[#52645f]">
            Jeśli awatar jest zapisany, możesz przejść do strony sesji i rozpocząć jedną darmową 15-minutową próbę
            świadomym kliknięciem startu.
          </p>
        </aside>
      </div>

      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a
          href="/account/security"
          class="inline-flex h-11 items-center justify-center rounded-lg border border-[#9cc8bc] bg-white px-5 text-sm font-medium text-[#1f6f65] transition-colors hover:bg-[#eef8f4] focus:ring-2 focus:ring-[#2d8a7d] focus:outline-none"
        >
          Ustaw hasło
        </a>

        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            class="inline-flex h-11 items-center justify-center rounded-lg border border-[#9cc8bc] bg-white px-5 text-sm font-medium text-[#1f6f65] transition-colors hover:bg-[#eef8f4] focus:ring-2 focus:ring-[#2d8a7d] focus:outline-none"
          >
            Wyloguj się
          </button>
        </form>
      </div>
    </section>
  </main>
</Layout>
