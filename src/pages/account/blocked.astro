---
import Layout from "@/layouts/Layout.astro";

const state = Astro.url.searchParams.get("state");
const isUnavailable = state === "unavailable";
---

<Layout title="Konto niedostępne - SafeSpace" lang="pl">
  <main class="min-h-screen bg-[#f4faf7] px-4 py-8 text-[#12201d] sm:px-6 lg:px-8">
    <section class="mx-auto flex min-h-[calc(100vh-64px)] max-w-2xl items-center">
      <div
        class="w-full rounded-lg border border-[#c8ddd7] bg-white p-6 shadow-[0_22px_60px_rgba(24,78,70,0.12)] sm:p-8"
      >
        <p class="text-sm font-medium text-[#1f6f65]">SafeSpace</p>
        <h1 class="mt-3 text-2xl font-semibold text-[#10231f]">Konto jest chwilowo niedostępne</h1>
        <p class="mt-4 text-sm leading-6 text-[#52645f]">
          {
            isUnavailable
              ? "Nie możemy teraz potwierdzić dostępu do prywatnej części produktu. Spróbuj ponownie później albo wyloguj się."
              : "Dostęp do prywatnej części produktu jest niedostępny dla tego konta. Możesz się wylogować i skontaktować z obsługą SafeSpace."
          }
        </p>
        <p class="mt-4 text-sm leading-6 text-[#52645f]">
          Ta strona nie pokazuje historii sesji, podsumowań, statystyk konta ani szczegółów decyzji administracyjnych.
        </p>

        <form method="POST" action="/api/auth/signout" class="mt-6">
          <button
            type="submit"
            class="inline-flex h-11 items-center justify-center rounded-lg bg-[#1f6f65] px-5 text-sm font-medium text-white transition-colors hover:bg-[#185950] focus:ring-2 focus:ring-[#2d8a7d] focus:outline-none"
          >
            Wyloguj się
          </button>
        </form>
      </div>
    </section>
  </main>
</Layout>
