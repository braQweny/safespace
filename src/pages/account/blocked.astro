---
import Layout from "@/layouts/Layout.astro";

const state = Astro.url.searchParams.get("state");
const isUnavailable = state === "unavailable";
---

<Layout title="Konto niedostępne - SafeSpace" lang="pl">
  <main class="bg-canvas text-ink min-h-screen px-4 py-8 sm:px-6 lg:px-8">
    <section class="mx-auto flex min-h-[calc(100vh-64px)] max-w-2xl items-center">
      <div
        class="border-line-strong w-full rounded-lg border bg-white p-6 shadow-[0_22px_60px_rgba(24,78,70,0.12)] sm:p-8"
      >
        <p class="text-brand text-sm font-medium">SafeSpace</p>
        <h1 class="text-ink mt-3 text-2xl font-semibold">Konto jest chwilowo niedostępne</h1>
        <p class="text-ink-muted mt-4 text-sm leading-6">
          {
            isUnavailable
              ? "Nie możemy teraz potwierdzić dostępu do prywatnej części produktu. Spróbuj ponownie później albo wyloguj się."
              : "Dostęp do prywatnej części SafeSpace został zablokowany dla tego konta. Możesz się wylogować i skontaktować z obsługą SafeSpace."
          }
        </p>
        <p class="text-ink-muted mt-4 text-sm leading-6">
          Ze względów prywatności ta strona nie pokazuje szczegółów konta ani powodu decyzji.
        </p>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="bg-brand hover:bg-brand-strong focus:ring-brand-ring inline-flex h-11 items-center justify-center rounded-lg px-5 text-sm font-medium text-white transition-colors focus:ring-2 focus:outline-none"
            >
              Wyloguj się
            </button>
          </form>
          <a
            href="/"
            class="border-line-accent bg-surface text-brand hover:bg-surface-hover focus:ring-brand-ring inline-flex h-11 items-center justify-center rounded-lg border px-5 text-sm font-medium transition-colors focus:ring-2 focus:outline-none"
          >
            Wróć na stronę główną
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
