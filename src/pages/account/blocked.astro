---
import SiteFooter from "@/components/SiteFooter.astro";
import Layout from "@/layouts/Layout.astro";
import { readAccountAccessState } from "@/lib/admin/account-access";
import { getSupportContact } from "@/lib/support-contact";

const state = Astro.url.searchParams.get("state");
const isUnavailable = state === "unavailable";

// Middleware celowo nie sprawdza dostępu na tej stronie (inaczej blokada
// zapętliłaby się na samej sobie), więc konto aktywne, które trafi tu z
// zakładki albo starego linku, odsyłamy do panelu — zamiast pokazywać mu
// nieprawdziwy komunikat o blokadzie. Przy `?state=unavailable` sprawdzenie
// właśnie zawiodło, więc nie powtarzamy go tutaj.
if (Astro.locals.user && !isUnavailable) {
  const access = await readAccountAccessState(Astro);

  if (access.ok && access.data.status !== "blocked") {
    return Astro.redirect("/dashboard", 302);
  }
}

const support = getSupportContact();
---

<Layout title="Konto niedostępne - SafeSpace" lang="pl">
  <div class="bg-paper text-ink flex min-h-screen flex-col">
    <main class="flex flex-1 items-center px-4 py-8 sm:px-6 lg:px-8">
      <section class="mx-auto w-full max-w-2xl">
        <div class="border-line-strong shadow-card bg-surface w-full rounded-lg border p-6 sm:p-8">
          <p class="text-brand text-sm font-medium">SafeSpace</p>
          <h1 class="text-ink mt-3 text-3xl leading-tight">Konto jest chwilowo niedostępne</h1>
          <p class="text-ink-muted mt-4 text-sm leading-6">
            {
              isUnavailable
                ? "Nie możemy teraz potwierdzić dostępu do prywatnej części produktu. Spróbuj ponownie później albo wyloguj się."
                : "Dostęp do prywatnej części SafeSpace został zablokowany dla tego konta. Możesz się wylogować i skontaktować z obsługą SafeSpace."
            }
          </p>
          <p class="text-ink-muted mt-4 text-sm leading-6">
            Ze względów prywatności ta strona nie pokazuje szczegółów konta ani powodu decyzji.
          </p>
          {
            support.mailtoHref ? (
              <p class="text-ink-muted mt-4 text-sm leading-6">
                Kontakt z obsługą:{" "}
                <a
                  href={support.mailtoHref}
                  class="text-brand focus-visible:ring-brand-ring rounded font-semibold underline-offset-4 hover:underline focus:ring-2 focus:outline-none"
                >
                  {support.email}
                </a>
                . Napisz z adresu e‑mail swojego konta — nie podawaj treści rozmów.
              </p>
            ) : null
          }

          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <form method="POST" action="/api/auth/signout">
              <button
                type="submit"
                class="bg-brand text-surface hover:bg-brand-strong focus-visible:ring-brand-ring inline-flex h-11 items-center justify-center rounded-lg px-5 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2"
              >
                Wyloguj się
              </button>
            </form>
            <a
              href="/"
              class="border-line-accent bg-surface text-brand hover:bg-surface-hover focus-visible:ring-brand-ring inline-flex h-11 items-center justify-center rounded-lg border px-5 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2"
            >
              Wróć na stronę główną
            </a>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter compact />
  </div>
</Layout>
