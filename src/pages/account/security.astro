---
import Layout from "@/layouts/Layout.astro";
import SetPasswordForm from "@/components/auth/SetPasswordForm";
import { getAuthErrorMessageFromSearchParam } from "@/lib/auth-errors";

const error = getAuthErrorMessageFromSearchParam(Astro.url.searchParams.get("error"));
const status = Astro.url.searchParams.get("status");
const successMessage =
  status === "password_updated"
    ? "Hasło zostało zapisane. Możesz logować się e-mailem i hasłem albo przez Google."
    : null;
const { user } = Astro.locals;
---

<Layout title="Bezpieczeństwo konta - SafeSpace" lang="pl">
  <main class="bg-canvas text-ink min-h-screen px-4 py-8 sm:px-6 lg:px-8">
    <section class="mx-auto flex min-h-[calc(100vh-64px)] max-w-2xl items-center">
      <div
        class="border-line-strong w-full rounded-lg border bg-white p-6 shadow-[0_22px_60px_rgba(24,78,70,0.12)] sm:p-8"
      >
        <a
          href="/dashboard"
          class="text-brand hover:text-brand-strong text-sm font-medium transition-colors hover:underline"
        >
          Wróć do panelu
        </a>
        <h1 class="text-ink mt-3 text-2xl font-semibold">Bezpieczeństwo konta</h1>
        <p class="text-ink-muted mt-3 text-sm leading-6">
          Zalogowano jako <span class="text-ink font-semibold">{user?.email}</span>. Jeśli konto powstało przez Google,
          ustawienie hasła dodaje logowanie e-mailem bez tworzenia drugiego konta.
        </p>

        <div class="mt-6">
          <SetPasswordForm serverError={error} serverSuccess={successMessage} client:load />
        </div>
      </div>
    </section>
  </main>
</Layout>
