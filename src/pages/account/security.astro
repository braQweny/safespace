---
import Layout from "@/layouts/Layout.astro";
import SetPasswordForm from "@/components/auth/SetPasswordForm";

const error = Astro.url.searchParams.get("error");
const status = Astro.url.searchParams.get("status");
const successMessage =
  status === "password_updated"
    ? "Hasło zostało zapisane. Możesz logować się e-mailem i hasłem albo przez Google."
    : null;
const { user } = Astro.locals;
---

<Layout title="Bezpieczeństwo konta - SafeSpace" lang="pl">
  <main class="min-h-screen bg-[#f4faf7] px-4 py-8 text-[#12201d] sm:px-6 lg:px-8">
    <section class="mx-auto flex min-h-[calc(100vh-64px)] max-w-2xl items-center">
      <div
        class="w-full rounded-lg border border-[#c8ddd7] bg-white p-6 shadow-[0_22px_60px_rgba(24,78,70,0.12)] sm:p-8"
      >
        <a
          href="/dashboard"
          class="text-sm font-medium text-[#1f6f65] transition-colors hover:text-[#164e47] hover:underline"
        >
          Wróć do panelu
        </a>
        <h1 class="mt-3 text-2xl font-semibold text-[#10231f]">Bezpieczeństwo konta</h1>
        <p class="mt-3 text-sm leading-6 text-[#52645f]">
          Jesteś zalogowany jako <span class="font-semibold text-[#10231f]">{user?.email}</span>. Jeśli konto powstało
          przez Google, ustawienie hasła dodaje logowanie e-mailem bez tworzenia drugiego konta.
        </p>

        <div class="mt-6">
          <SetPasswordForm serverError={error} serverSuccess={successMessage} client:load />
        </div>
      </div>
    </section>
  </main>
</Layout>
