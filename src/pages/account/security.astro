---
import AppHeader from "@/components/AppHeader.astro";
import LocaleSwitch from "@/components/LocaleSwitch.astro";
import PeopleMemoryToggle from "@/components/account/PeopleMemoryToggle.astro";
import { getLocaleSwitchCopy } from "@/components/locale-switch-copy";
import { hasOwnedPeopleRows, readOwnedPeopleMemoryEnabled } from "@/lib/session-data/repository";
import { isPeopleSettingsStatusCode } from "@/lib/session-flow/people-contract";
import { isPeopleMemoryEnabled } from "@/lib/session-flow/people-memory-mode";
import SiteFooter from "@/components/SiteFooter.astro";
import Layout from "@/layouts/Layout.astro";
import SetPasswordForm from "@/components/auth/SetPasswordForm";
import { getAdminContext } from "@/lib/admin/auth";
import { getBillingCopy } from "@/lib/billing/copy";
import { isBillingEnabled } from "@/lib/billing/config";
import { getAuthErrorMessageFromSearchParam } from "@/lib/auth-errors";
import { getSessionDataContext } from "@/lib/session-data/auth";
import { readSessionQuota } from "@/lib/session-data/quota";
import type { SessionQuota } from "@/lib/session-data/types";
import { readActiveSessionBadge, type ActiveSessionBadge } from "@/lib/session-flow/active-session-badge";
import { getAccountPagesCopy } from "@/lib/page-copy/account-pages-copy";
import {
  formatPlanName,
  formatSessionAllowance,
  getPlanCopy,
  getPremiumSupportMailtoHref,
} from "@/lib/session-flow/plan-copy";
import { formatSessionBudgetMinutes, resolveSessionDurationSeconds } from "@/lib/session-flow/session-budget";
import { getSupportContact } from "@/lib/support-contact";

const locale = Astro.locals.locale;
const copy = getAccountPagesCopy(locale).security;
const billingCopy = getBillingCopy(locale);
const billingEnabled = isBillingEnabled();
const error = getAuthErrorMessageFromSearchParam(locale, Astro.url.searchParams.get("error"));
const status = Astro.url.searchParams.get("status");
const successMessage = status === "password_updated" ? copy.passwordUpdated : null;
const { user } = Astro.locals;

// Administracja miała własną powłokę, ale żaden widok aplikacji do niej nie
// prowadził. Sprawdzenie kosztuje jedno zapytanie i tylko na tej stronie.
const adminContext = await getAdminContext(Astro);
const isAdmin = adminContext.ok;

// Plan i pula rozmów są czytane tą samą ścieżką co karta startu w panelu
// (`readSessionQuota`), żeby konto nigdy nie mówiło czego innego niż panel.
const sessionContext = getSessionDataContext(Astro);
let quota: SessionQuota | null = null;
let activeSession: ActiveSessionBadge | null = null;
// Karty osób: przełącznik za flagą, ale usuwanie zapisów zawsze — jeśli jakieś
// są, karta ustawień pokazuje się także przy wyłączonej fladze.
const peopleMemoryMode = isPeopleMemoryEnabled();
let peopleMemoryEnabled: boolean | null = null;
let hasPeopleRows = false;

if (sessionContext.ok) {
  const [quotaResult, badge, preference, rows] = await Promise.all([
    readSessionQuota(sessionContext.data),
    readActiveSessionBadge(sessionContext.data),
    peopleMemoryMode ? readOwnedPeopleMemoryEnabled(sessionContext.data) : null,
    hasOwnedPeopleRows(sessionContext.data),
  ]);
  quota = quotaResult.ok ? quotaResult.data : null;
  activeSession = badge;
  peopleMemoryEnabled = preference?.ok ? preference.data : null;
  hasPeopleRows = rows.ok ? rows.data : false;
}

const support = getSupportContact();
const localeCopy = getLocaleSwitchCopy(locale);
const sessionBudgetMinutes = formatSessionBudgetMinutes(locale, resolveSessionDurationSeconds(quota?.plan));
const peopleCopy = copy.peopleMemory;
const showsPeopleCard = peopleMemoryMode || hasPeopleRows;
const peopleStatus = Astro.url.searchParams.get("people");
const peopleStatusMessage = isPeopleSettingsStatusCode(peopleStatus) ? peopleCopy.status[peopleStatus] : null;
const peopleStatusIsError = peopleStatus !== "saved" && peopleStatus !== "deleted";
---

<Layout title={copy.pageTitle}>
  <div class="bg-paper text-ink flex min-h-screen flex-col">
    <AppHeader activeSession={activeSession} />

    <main class="flex-1 px-4 py-8 sm:px-6 lg:px-8">
      <section class="mx-auto max-w-2xl">
        <a
          href="/dashboard"
          class="text-brand hover:text-brand-strong focus:ring-brand-ring inline-flex min-h-11 items-center rounded text-sm font-medium transition-colors hover:underline focus:ring-2 focus:outline-none"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="mr-1.5 h-4 w-4"
          >
            <path d="M19 12H5M11 18l-6-6 6-6"></path>
          </svg>
          {copy.back}
        </a>
        <h1 class="text-ink mt-3 text-4xl leading-tight">{copy.title}</h1>
        <p class="text-ink-muted mt-3 text-sm leading-6">
          {copy.signedInAs}
          <span class="text-ink font-semibold">{user?.email}</span>.
        </p>

        <div class="border-line-strong bg-surface shadow-card mt-6 rounded-[20px] border p-6 sm:p-8" data-account-plan>
          <h2 class="text-ink text-lg font-semibold">{copy.planTitle}</h2>
          {
            quota ? (
              <>
                <p class="text-brand mt-2 text-base font-semibold">{formatPlanName(locale, quota.plan)}</p>
                <p class="text-ink-muted mt-1 text-sm leading-6">
                  {formatSessionAllowance(locale, quota)} {copy.eachLasts(sessionBudgetMinutes)}
                  {quota.plan === "free" ? ` ${copy.deletingNote}` : null}
                </p>
                {quota.plan === "free" && !billingEnabled ? (
                  <p class="text-ink-muted mt-3 text-sm leading-6">{getPlanCopy(locale).premiumHowTo}</p>
                ) : null}
                {quota.plan === "free" && !billingEnabled && support.mailtoHref ? (
                  <a
                    href={getPremiumSupportMailtoHref(locale, support.mailtoHref)}
                    class="border-line-accent bg-surface text-brand hover:bg-surface-hover focus-visible:ring-brand-ring mt-4 inline-flex h-11 items-center justify-center rounded-full border px-4 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2"
                  >
                    {copy.writeAboutPremium}
                  </a>
                ) : null}
              </>
            ) : (
              <p class="text-ink-muted mt-2 text-sm leading-6">{copy.planReadFailed}</p>
            )
          }
          <a
            href="/account/billing"
            class="border-line-accent bg-surface text-brand hover:bg-surface-hover focus-visible:ring-brand-ring mt-4 inline-flex min-h-11 items-center justify-center rounded-full border px-4 py-2 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2"
          >
            {quota?.plan === "free" && billingEnabled ? billingCopy.discover : billingCopy.link}
          </a>
        </div>

        <div class="border-line-strong bg-surface shadow-card mt-5 rounded-[20px] border p-6 sm:p-8">
          <h2 class="text-ink text-lg font-semibold">{copy.passwordTitle}</h2>
          <p class="text-ink-muted mt-2 text-sm leading-6">{copy.passwordIntro}</p>

          <div class="mt-6">
            <SetPasswordForm locale={locale} serverError={error} serverSuccess={successMessage} client:idle />
          </div>
        </div>

        <div
          class="border-line-strong bg-surface shadow-card mt-5 rounded-[20px] border p-6 sm:p-8"
          data-account-locale
        >
          <h2 class="text-ink text-lg font-semibold">{localeCopy.label}</h2>
          <p class="text-ink-muted mt-2 text-sm leading-6">{localeCopy.description}</p>
          <div class="mt-4 max-w-xs">
            <LocaleSwitch variant="segmented" />
          </div>
        </div>

        {
          showsPeopleCard ? (
            <div
              class="border-line-strong bg-surface shadow-card mt-5 rounded-[20px] border p-6 sm:p-8"
              id="people-memory"
              data-account-people
            >
              <h2 class="text-ink text-lg font-semibold">{peopleCopy.title}</h2>
              <p class="text-ink-muted mt-2 text-sm leading-6">
                {peopleMemoryMode ? peopleCopy.intro : peopleCopy.modeOffIntro}
              </p>
              {peopleStatusMessage ? (
                <p
                  role={peopleStatusIsError ? "alert" : "status"}
                  class:list={[
                    "mt-3 rounded-xl p-3.5 text-sm leading-6",
                    peopleStatusIsError
                      ? "border-danger-line bg-danger-soft text-danger border"
                      : "bg-brand-tint text-brand-deep",
                  ]}
                >
                  {peopleStatusMessage}
                </p>
              ) : null}
              {peopleMemoryMode ? (
                peopleMemoryEnabled === null ? (
                  <p class="text-ink-muted mt-3 text-sm leading-6">{peopleCopy.readFailed}</p>
                ) : (
                  <>
                    <div class="mt-4 max-w-xs">
                      <PeopleMemoryToggle enabled={peopleMemoryEnabled} />
                    </div>
                    <p class="text-ink-muted mt-3 text-sm leading-6">{peopleCopy.effects}</p>
                  </>
                )
              ) : null}
              {/* Potwierdzenie bez JS: wymagane pole wyboru w natywnym formularzu. */}
              <details class="mt-5">
                <summary class="text-ink-muted hover:bg-danger-soft hover:text-danger focus-visible:ring-danger-strong inline-flex h-11 cursor-pointer items-center rounded-full px-3.5 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2">
                  {peopleCopy.deleteAllSummary}
                </summary>
                <form method="POST" action="/api/session/people/delete-all" class="mt-3" data-people-delete-all>
                  <p class="text-ink-muted text-sm leading-6">{peopleCopy.deleteAllBody}</p>
                  <label class="text-ink mt-3 flex items-start gap-2 text-sm leading-6">
                    <input type="checkbox" name="confirm" value="1" required class="mt-1 h-4 w-4 shrink-0" />
                    <span>{peopleCopy.deleteAllConfirmLabel}</span>
                  </label>
                  <button
                    type="submit"
                    class="bg-danger text-surface hover:bg-danger-strong focus-visible:ring-danger-strong mt-4 inline-flex h-12 items-center justify-center rounded-[14px] px-6 text-base font-semibold transition-colors focus:outline-none focus-visible:ring-2"
                  >
                    {peopleCopy.deleteAllSubmit}
                  </button>
                </form>
              </details>
            </div>
          ) : null
        }

        <div class="border-line bg-surface-soft mt-5 rounded-2xl border p-5">
          <h2 class="text-brand-deep text-base font-semibold">{copy.dataTitle}</h2>
          <p class="text-ink-muted mt-2 text-sm leading-6">
            {copy.dataIntro}
            <a
              href="/privacy"
              class="text-brand hover:text-brand-strong focus:ring-brand-ring ml-1 rounded font-medium underline underline-offset-4 focus:ring-2 focus:outline-none"
            >
              {copy.privacyLink}
            </a>
          </p>
          <a
            href="/account/delete"
            class="border-danger-line text-danger hover:bg-danger-soft focus-visible:ring-brand-ring mt-4 inline-flex min-h-11 items-center rounded-full border px-4 py-2 text-sm font-medium focus:outline-none focus-visible:ring-2"
            >{copy.deleteAccount}</a
          >
          <p class="text-ink-muted mt-2 text-sm leading-6">{copy.deleteNote}</p>
        </div>

        {
          isAdmin ? (
            <div class="border-line bg-surface-soft mt-5 rounded-2xl border p-5">
              <h2 class="text-brand-deep text-base font-semibold">{copy.adminTitle}</h2>
              <p class="text-ink-muted mt-2 text-sm leading-6">{copy.adminIntro}</p>
              <a
                href="/admin"
                class="border-line-accent bg-surface text-brand hover:bg-surface-hover focus-visible:ring-brand-ring mt-4 inline-flex h-11 items-center justify-center rounded-full border px-4 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2"
              >
                {copy.openAdmin}
              </a>
            </div>
          ) : null
        }
      </section>
    </main>

    <SiteFooter />
  </div>
</Layout>
