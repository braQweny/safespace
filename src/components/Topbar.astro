---
const { user } = Astro.locals;
---

<div
  class="mb-4 flex flex-col gap-3 rounded-lg border border-[#d3e7e1] bg-white/80 px-4 py-3 text-sm text-[#344f48] shadow-sm sm:flex-row sm:items-center sm:justify-between"
>
  {
    user ? (
      <>
        <span class="break-all text-[#52645f]">Zalogowano: {user.email}</span>
        <div class="flex flex-wrap items-center gap-3">
          <a href="/dashboard" class="text-[#1f6f65] transition-colors hover:text-[#164e47] hover:underline">
            Panel
          </a>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="text-[#1f6f65] transition-colors hover:text-[#164e47] hover:underline">
              Wyloguj się
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span class="text-[#52645f]">Nie jesteś zalogowany</span>
        <div class="flex flex-wrap gap-3">
          <a href="/auth/signin" class="text-[#1f6f65] transition-colors hover:text-[#164e47] hover:underline">
            Zaloguj się
          </a>
          <a href="/auth/signup" class="text-[#1f6f65] transition-colors hover:text-[#164e47] hover:underline">
            Utwórz konto
          </a>
        </div>
      </>
    )
  }
</div>
