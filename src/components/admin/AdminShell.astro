---
interface Props {
  title: string;
  active: "overview" | "users";
  adminEmail?: string | null;
}

const { title, active, adminEmail = null } = Astro.props;
const navItems = [
  { href: "/admin", label: "Statystyki", id: "overview" },
  { href: "/admin/users", label: "Użytkownicy", id: "users" },
] as const;
---

<main class="text-ink bg-paper min-h-screen">
  <header class="border-line bg-surface border-b">
    <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-5 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <a
            href="/dashboard"
            class="focus:ring-brand-ring text-brand rounded text-sm font-medium transition-colors hover:underline focus:ring-2 focus:outline-none"
          >
            ← Wróć do panelu
          </a>
          <p class="text-brand mt-2 text-sm font-medium">Administracja SafeSpace</p>
          <h1 class="text-ink mt-1 text-3xl leading-tight">{title}</h1>
        </div>
        <div class="flex flex-col items-start gap-2 sm:items-end">
          {adminEmail ? <p class="text-ink-muted text-sm break-all">{adminEmail}</p> : null}
          {
            /* Powłoka admina nie ma AppHeadera, więc bez tego formularza nie
               dało się stąd wylogować inaczej niż wracając do panelu. */
          }
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="border-line text-ink-muted hover:bg-surface-soft focus-visible:ring-brand-ring bg-surface inline-flex h-11 items-center rounded-lg border px-3.5 text-sm transition-colors focus:outline-none focus-visible:ring-2"
            >
              Wyloguj się
            </button>
          </form>
        </div>
      </div>
      <nav class="flex flex-wrap gap-2" aria-label="Nawigacja admina">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={active === item.id ? "page" : undefined}
              class:list={[
                "inline-flex h-11 items-center justify-center rounded-md border px-3.5 text-sm font-medium transition-colors",
                active === item.id
                  ? "border-brand-strong bg-brand-strong text-surface"
                  : "border-brand-soft hover:bg-surface-hover text-brand bg-surface",
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
  </header>
  <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 lg:px-8">
    <slot />
  </div>
</main>
