---
import Topbar from "@/components/Topbar.astro";

const steps = [
  {
    title: "Zakładasz konto",
    body: "Darmowa sesja jest dostępna po zalogowaniu, żeby zachować prywatny kontekst i nie uruchamiać rozmowy anonimowo.",
  },
  {
    title: "Wybierasz perspektywę",
    body: "W prywatnej części produktu wybierzesz awatara reprezentującego nurt psychoterapii i przeczytasz krótki opis podejścia.",
  },
  {
    title: "Przechodzisz do rozmowy",
    body: "Pierwsza sesja ma być limitowana do 15 minut, z widocznym czasem i jasną informacją, że to symulacja edukacyjna.",
  },
];

const boundaries = [
  "SafeSpace nie zastępuje psychoterapeuty, lekarza ani konsultacji ze specjalistą.",
  "Produkt nie stawia diagnozy i nie dobiera leczenia ani nurtu terapii za użytkownika.",
  "Treść rozmowy ma charakter symulacji i wsparcia edukacyjnego, a nie porady medycznej.",
  "W sytuacji bezpośredniego zagrożenia potrzebny jest kontakt z realną pomocą, nie z aplikacją.",
];
---

<div class="min-h-screen w-full bg-[#f4faf7] text-[#12201d]">
  <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
    <Topbar />
  </div>

  <main>
    <section class="mx-auto grid max-w-7xl gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[0.92fr_1.08fr] lg:px-8 lg:py-16">
      <div class="max-w-2xl self-center">
        <p class="inline-flex rounded-lg border border-[#9cc8bc] bg-white px-3 py-1 text-sm font-medium text-[#285d55]">
          Edukacyjna symulacja rozmowy wspierana przez AI
        </p>
        <h1 class="mt-5 text-4xl leading-tight font-semibold text-[#10231f] sm:text-5xl lg:text-6xl">SafeSpace</h1>
        <p class="mt-6 max-w-xl text-lg leading-8 text-[#38524b]">
          Spokojne wejście do pierwszej rozmowy o trudnościach psychicznych. Produkt pomaga uporządkować myśli i
          zobaczyć, jak może wyglądać praca w różnych nurtach psychoterapii.
        </p>
        <p
          class="mt-5 max-w-xl rounded-lg border border-[#e5c982] bg-[#fff9e7] px-4 py-3 text-sm leading-6 text-[#674b12]"
        >
          SafeSpace nie jest terapią, diagnozą ani pomocą kryzysową. W nagłym zagrożeniu życia lub zdrowia skontaktuj
          się z numerem 112, lokalnymi służbami, telefonem zaufania albo specjalistą.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href="/auth/signup"
            class="inline-flex h-12 items-center justify-center rounded-lg bg-[#1f6f65] px-5 text-base font-medium text-white transition-colors hover:bg-[#185950] focus:ring-2 focus:ring-[#2d8a7d] focus:outline-none"
          >
            Utwórz konto
          </a>
          <a
            href="/auth/signin"
            class="inline-flex h-12 items-center justify-center rounded-lg border border-[#8ab7ad] bg-white px-5 text-base font-medium text-[#1f514a] transition-colors hover:bg-[#e9f4f1] focus:ring-2 focus:ring-[#2d8a7d] focus:outline-none"
          >
            Mam już konto
          </a>
        </div>
        <p class="mt-5 max-w-xl text-sm leading-6 text-[#52645f]">
          Konto jest wymagane przed dostępem do jednej bezpłatnej, 15-minutowej sesji. Ten widok nie uruchamia jeszcze
          rozmowy ani nie zapisuje historii.
        </p>
      </div>

      <figure class="w-full self-center">
        <img
          src="/safespace-landing.png"
          width="800"
          height="533"
          alt="Ekran aplikacji SafeSpace z rozmową, timerem i oznaczeniami prywatności"
          class="aspect-[800/533] w-full rounded-lg border border-[#c8ddd7] bg-white object-cover shadow-[0_24px_70px_rgba(24,78,70,0.18)]"
          decoding="async"
          loading="eager"
        />
        <figcaption class="mt-3 text-sm leading-6 text-[#52645f]">
          Wizualizacja pokazuje przyszły kontekst rozmowy, limit czasu i prywatność bez obietnicy diagnozy.
        </figcaption>
      </figure>
    </section>

    <section class="border-y border-[#d6e6e1] bg-white">
      <div class="mx-auto grid max-w-7xl gap-6 px-4 py-10 sm:px-6 lg:grid-cols-3 lg:px-8 lg:py-12">
        <div class="lg:col-span-1">
          <p class="text-sm font-medium text-[#1f6f65]">Jak to ma działać</p>
          <h2 class="mt-3 text-2xl leading-tight font-semibold text-[#10231f]">Krótka ścieżka przed pierwszą sesją</h2>
        </div>
        <ol class="grid gap-4 sm:grid-cols-3 lg:col-span-2">
          {
            steps.map((step, index) => (
              <li class="rounded-lg border border-[#d7e5e0] bg-[#f8fcfa] p-5">
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-[#1f6f65] text-sm font-semibold text-white">
                  {index + 1}
                </span>
                <h3 class="mt-4 text-base font-semibold text-[#173f39]">{step.title}</h3>
                <p class="mt-2 text-sm leading-6 text-[#52645f]">{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section
      class="mx-auto grid max-w-7xl gap-6 px-4 py-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_360px] lg:px-8 lg:py-12"
    >
      <div>
        <p class="text-sm font-medium text-[#1f6f65]">Jedna bezpłatna sesja</p>
        <h2 class="mt-3 max-w-3xl text-3xl leading-tight font-semibold text-[#10231f]">
          15 minut, konto użytkownika i jasne granice przed rozmową
        </h2>
        <p class="mt-4 max-w-3xl text-base leading-7 text-[#38524b]">
          SafeSpace przygotowuje dostęp do pierwszej, limitowanej sesji w przeglądarce. Konto jest potrzebne, żeby
          prowadzić prywatny przepływ użytkownika, a wybór awatara pomoże opisać edukacyjną perspektywę przyszłej
          rozmowy.
        </p>
        <p class="mt-4 max-w-3xl text-base leading-7 text-[#38524b]">
          Sama rozmowa, timer, historia i podsumowania należą do kolejnych kroków produktu. Ten landing ma najpierw
          wyjaśnić ofertę i ograniczenia, zanim użytkownik zdecyduje się założyć konto.
        </p>
      </div>
      <aside class="rounded-lg border border-[#c8ddd7] bg-white p-5 shadow-[0_18px_50px_rgba(24,78,70,0.10)]">
        <h3 class="text-base font-semibold text-[#173f39]">Co obiecuje ten etap</h3>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-[#52645f]">
          <li>Informację o produkcie przed rejestracją.</li>
          <li>Jasny dostęp do rejestracji i logowania.</li>
          <li>Granice bezpieczeństwa widoczne przed CTA.</li>
        </ul>
      </aside>
    </section>

    <section class="bg-[#182a2a] text-white">
      <div class="mx-auto grid max-w-7xl gap-6 px-4 py-10 sm:px-6 lg:grid-cols-[0.85fr_1.15fr] lg:px-8 lg:py-12">
        <div>
          <p class="text-sm font-medium text-[#9ed8cc]">Granice bezpieczeństwa</p>
          <h2 class="mt-3 text-3xl leading-tight font-semibold">Zanim zaczniesz, wiedz czego produkt nie robi</h2>
          <p class="mt-4 text-base leading-7 text-[#d8e8e3]">
            SafeSpace ma pomagać w przygotowaniu do realnej rozmowy i edukacyjnie pokazywać możliwe sposoby pracy. Nie
            ma zastępować kontaktu z wykwalifikowaną osobą.
          </p>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          {
            boundaries.map((boundary) => (
              <p class="rounded-lg border border-white/15 bg-white/8 p-4 text-sm leading-6 text-[#eef7f4]">
                {boundary}
              </p>
            ))
          }
        </div>
      </div>
      <div class="border-t border-white/10">
        <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
          <p class="max-w-4xl text-sm leading-6 text-[#ffdcb0]">
            Jeśli jesteś w bezpośrednim niebezpieczeństwie, zadzwoń pod 112 albo skontaktuj się z lokalną pomocą
            kryzysową, telefonem zaufania lub specjalistą. Nie czekaj na odpowiedź aplikacji.
          </p>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
      <div
        class="grid gap-5 rounded-lg border border-[#c8ddd7] bg-white p-6 shadow-[0_18px_50px_rgba(24,78,70,0.10)] lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center"
      >
        <div>
          <p class="text-sm font-medium text-[#1f6f65]">Gotowy zobaczyć prywatną część?</p>
          <h2 class="mt-2 text-2xl font-semibold text-[#10231f]">Załóż konto przed dostępem do przyszłej sesji</h2>
          <p class="mt-3 max-w-3xl text-sm leading-6 text-[#52645f]">
            Rejestracja prowadzi do istniejącej ścieżki auth. SafeSpace nie uruchamia sesji z publicznego landingu.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:justify-end">
          <a
            href="/auth/signup"
            class="inline-flex h-11 items-center justify-center rounded-lg bg-[#1f6f65] px-5 text-sm font-medium text-white transition-colors hover:bg-[#185950] focus:ring-2 focus:ring-[#2d8a7d] focus:outline-none"
          >
            Utwórz konto
          </a>
          <a
            href="/auth/signin"
            class="inline-flex h-11 items-center justify-center rounded-lg border border-[#8ab7ad] bg-white px-5 text-sm font-medium text-[#1f514a] transition-colors hover:bg-[#e9f4f1] focus:ring-2 focus:ring-[#2d8a7d] focus:outline-none"
          >
            Zaloguj się
          </a>
        </div>
      </div>
    </section>
  </main>
</div>
