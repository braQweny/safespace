---
import AppHeader from "@/components/AppHeader.astro";
import { AUTHENTICATED_REDIRECT_PATH } from "@/lib/auth-redirect";

const { user } = Astro.locals;
const primaryCta = user
  ? {
      href: AUTHENTICATED_REDIRECT_PATH,
      label: "Przejdź do panelu",
    }
  : {
      href: "/auth/signup",
      label: "Utwórz konto",
    };
const secondaryCta = user
  ? null
  : {
      href: "/auth/signin",
      label: "Mam już konto",
    };

const steps = [
  {
    title: "Zakładasz konto",
    body: "Darmowa sesja jest dostępna po zalogowaniu, żeby zachować prywatny kontekst i nie uruchamiać rozmowy anonimowo.",
  },
  {
    title: "Wybierasz perspektywę",
    body: "W swoim panelu wybierzesz awatara reprezentującego nurt psychoterapii i przeczytasz krótki opis podejścia.",
  },
  {
    title: "Przechodzisz do rozmowy",
    body: "Pierwsza sesja jest limitowana do 15 minut, z widocznym czasem i jasną informacją, że to symulacja edukacyjna.",
  },
];

const boundaries = [
  "SafeSpace nie zastępuje psychoterapeuty, lekarza ani konsultacji ze specjalistą.",
  "Produkt nie stawia diagnozy i nie dobiera leczenia ani nurtu terapii za Ciebie.",
  "Treść rozmowy ma charakter symulacji i wsparcia edukacyjnego, a nie porady medycznej.",
  "W sytuacji bezpośredniego zagrożenia potrzebny jest kontakt z realną pomocą, nie z aplikacją.",
];
---

<div class="bg-canvas text-ink min-h-screen w-full">
  {
    /* Ten sam nagłówek co w aplikacji — zalogowana osoba nie trafia na drugi,
      niepodobny system nawigacji. */
  }
  <AppHeader />

  <main>
    <section
      class="mx-auto grid w-full max-w-7xl gap-10 overflow-x-hidden px-4 py-10 sm:px-6 lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)] lg:px-8 lg:py-16"
    >
      <div class="max-w-2xl min-w-0 self-center">
        <p
          class="border-line-accent inline-flex max-w-full rounded-lg border bg-white px-3 py-1 text-sm font-medium text-wrap text-[#285d55]"
        >
          Edukacyjna symulacja rozmowy wspierana przez AI
        </p>
        <h1 class="text-ink mt-5 text-4xl leading-tight font-semibold sm:text-5xl lg:text-6xl">SafeSpace</h1>
        <p class="text-ink-soft mt-6 max-w-xl text-lg leading-8">
          Spokojne wejście do pierwszej rozmowy o trudnościach psychicznych. Produkt pomaga uporządkować myśli i
          zobaczyć, jak może wyglądać praca w różnych nurtach psychoterapii.
        </p>
        <p class="border-warn-line bg-warn-soft text-warn mt-5 max-w-xl rounded-lg border px-4 py-3 text-sm leading-6">
          SafeSpace nie jest terapią, diagnozą ani pomocą kryzysową. W nagłym zagrożeniu życia lub zdrowia skontaktuj
          się z numerem 112, lokalnymi służbami, telefonem zaufania albo specjalistą.
        </p>
        <div class="mt-8 flex min-w-0 flex-col gap-3 sm:flex-row">
          <a
            href={primaryCta.href}
            class="bg-brand hover:bg-brand-strong focus:ring-brand-ring inline-flex h-12 items-center justify-center rounded-lg px-5 text-base font-medium text-white transition-colors focus:ring-2 focus:outline-none"
          >
            {primaryCta.label}
          </a>
          {
            secondaryCta ? (
              <a
                href={secondaryCta.href}
                class="hover:bg-surface-hover focus:ring-brand-ring inline-flex h-12 items-center justify-center rounded-lg border border-[#8ab7ad] bg-white px-5 text-base font-medium text-[#1f514a] transition-colors focus:ring-2 focus:outline-none"
              >
                {secondaryCta.label}
              </a>
            ) : null
          }
        </div>
        <p class="text-ink-muted mt-5 max-w-xl text-sm leading-6">
          {
            user
              ? "Zalogowano. Kolejny krok — wybór awatara i sesja — czeka w Twoim panelu."
              : "Darmowa, 15-minutowa sesja wymaga konta, żeby rozmowa pozostała prywatna. Ta strona niczego nie uruchamia ani nie zapisuje."
          }
        </p>
      </div>

      <figure class="max-w-full min-w-0 self-center">
        <img
          src="/safespace-landing.png"
          width="800"
          height="533"
          alt="Ekran aplikacji SafeSpace z rozmową, timerem i oznaczeniami prywatności"
          class="border-line-strong aspect-[800/533] w-full max-w-full rounded-lg border bg-white object-cover shadow-[0_24px_70px_rgba(24,78,70,0.18)]"
          decoding="async"
          loading="eager"
        />
        <figcaption class="text-ink-muted mt-3 max-w-full text-sm leading-6 text-wrap">
          Rozmowa toczy się w przeglądarce: z widocznym limitem czasu, prywatnym zapisem i bez obietnicy diagnozy.
        </figcaption>
      </figure>
    </section>

    <section class="border-y border-[#d6e6e1] bg-white">
      <div class="mx-auto grid max-w-7xl gap-6 px-4 py-10 sm:px-6 lg:grid-cols-3 lg:px-8 lg:py-12">
        <div class="lg:col-span-1">
          <p class="text-brand text-sm font-medium">Jak to działa</p>
          <h2 class="text-ink mt-3 text-2xl leading-tight font-semibold">Krótka ścieżka przed pierwszą sesją</h2>
          <p class="text-ink-muted mt-3 text-sm leading-6">
            Trzy kroki dzielą Cię od rozmowy. Żaden z nich nie uruchamia sesji przypadkiem — czas zaczyna biec dopiero
            po świadomym kliknięciu startu.
          </p>
        </div>
        <ol class="grid gap-4 sm:grid-cols-3 lg:col-span-2">
          {
            steps.map((step, index) => (
              <li class="border-line bg-surface-soft rounded-lg border p-5">
                <span class="bg-brand flex h-9 w-9 items-center justify-center rounded-full text-sm font-semibold text-white">
                  {index + 1}
                </span>
                <h3 class="text-brand-deep mt-4 text-base font-semibold">{step.title}</h3>
                <p class="text-ink-muted mt-2 text-sm leading-6">{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section
      class="mx-auto grid max-w-7xl gap-6 px-4 py-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_360px] lg:px-8 lg:py-12"
    >
      <div>
        <p class="text-brand text-sm font-medium">Jedna bezpłatna sesja</p>
        <h2 class="text-ink mt-3 max-w-3xl text-3xl leading-tight font-semibold">
          15 minut, konto użytkownika i jasne granice przed rozmową
        </h2>
        <p class="text-ink-soft mt-4 max-w-3xl text-base leading-7">
          SafeSpace udostępnia pierwszą, limitowaną sesję w przeglądarce. Konto jest potrzebne, żeby rozmowa i jej
          historia pozostały prywatne, a wybór awatara opisuje edukacyjną perspektywę przyszłej rozmowy.
        </p>
        <p class="text-ink-soft mt-4 max-w-3xl text-base leading-7">
          Po sesji możesz wrócić do zapisu rozmowy w prywatnej historii i zatwierdzić podsumowanie, które posłuży jako
          kontekst kolejnej rozmowy. Bez Twojej zgody żadna treść nie jest przenoszona dalej.
        </p>
      </div>
      <aside class="border-line-strong rounded-lg border bg-white p-5 shadow-[0_18px_50px_rgba(24,78,70,0.10)]">
        <h3 class="text-brand-deep text-base font-semibold">Co dostajesz</h3>
        <ul class="text-ink-muted mt-4 space-y-3 text-sm leading-6">
          <li>Jedną bezpłatną, 15-minutową sesję z wybraną perspektywą.</li>
          <li>Prywatną historię rozmów widoczną tylko dla Ciebie.</li>
          <li>Jasne granice bezpieczeństwa widoczne przed rozmową.</li>
        </ul>
      </aside>
    </section>

    <section class="bg-[#182a2a] text-white">
      <div class="mx-auto grid max-w-7xl gap-6 px-4 py-10 sm:px-6 lg:grid-cols-[0.85fr_1.15fr] lg:px-8 lg:py-12">
        <div>
          <p class="text-sm font-medium text-[#9ed8cc]">Granice bezpieczeństwa</p>
          <h2 class="mt-3 text-3xl leading-tight font-semibold">Zanim zaczniesz, wiedz, czego produkt nie robi</h2>
          <p class="mt-4 text-base leading-7 text-[#d8e8e3]">
            SafeSpace ma pomagać w przygotowaniu do realnej rozmowy i edukacyjnie pokazywać możliwe sposoby pracy. Nie
            ma zastępować kontaktu z wykwalifikowaną osobą.
          </p>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          {
            boundaries.map((boundary) => (
              <p class="text-surface-hover rounded-lg border border-white/15 bg-white/8 p-4 text-sm leading-6">
                {boundary}
              </p>
            ))
          }
        </div>
      </div>
      <div class="border-t border-white/10">
        <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
          <p class="max-w-4xl text-sm leading-6 text-[#ffdcb0]">
            Jeśli jesteś w bezpośrednim niebezpieczeństwie, zadzwoń pod 112 albo skontaktuj się z lokalną pomocą
            kryzysową, telefonem zaufania lub specjalistą. Nie czekaj na odpowiedź aplikacji.
          </p>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
      <div
        class="border-line-strong grid gap-5 rounded-lg border bg-white p-6 shadow-[0_18px_50px_rgba(24,78,70,0.10)] lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center"
      >
        <div>
          <p class="text-brand text-sm font-medium">
            {user ? "Wróć do swoich rozmów" : "Czas na pierwszy krok?"}
          </p>
          <h2 class="text-ink mt-2 text-2xl font-semibold">
            {user ? "Przejdź do swojego panelu" : "Załóż konto i przygotuj pierwszą sesję"}
          </h2>
          <p class="text-ink-muted mt-3 max-w-3xl text-sm leading-6">
            {
              user
                ? "W panelu wybierzesz awatara, rozpoczniesz sesję i wrócisz do zapisanych rozmów. Rozmowa nigdy nie zaczyna się na tej publicznej stronie."
                : "Rejestracja zajmuje chwilę i niczego nie uruchamia automatycznie — sesję zaczynasz świadomie, osobnym przyciskiem w panelu."
            }
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:justify-end">
          <a
            href={primaryCta.href}
            class="bg-brand hover:bg-brand-strong focus:ring-brand-ring inline-flex h-11 items-center justify-center rounded-lg px-5 text-sm font-medium text-white transition-colors focus:ring-2 focus:outline-none"
          >
            {primaryCta.label}
          </a>
          {
            secondaryCta ? (
              <a
                href={secondaryCta.href}
                class="hover:bg-surface-hover focus:ring-brand-ring inline-flex h-11 items-center justify-center rounded-lg border border-[#8ab7ad] bg-white px-5 text-sm font-medium text-[#1f514a] transition-colors focus:ring-2 focus:outline-none"
              >
                Zaloguj się
              </a>
            ) : null
          }
        </div>
      </div>
    </section>
  </main>
</div>
