---
import { getSiteFooterCopy } from "@/components/site-footer-copy";
import { getSupportContact } from "@/lib/support-contact";

/**
 * Wspólna stopka dla stron „zwykłych” (landing, panel, konto, auth, błędy).
 * Strona rozmowy jej nie ma — tam układ zajmuje cały ekran, a granice i pomoc
 * kryzysowa są już na widoku.
 */
interface Props {
  /** Gęstszy wariant dla kart wyśrodkowanych na ekranie (auth, 404). */
  compact?: boolean;
  /**
   * Te same krawędzie co `AppHeader`: `page` (domyślnie) stawia odstęp poza
   * `max-w-6xl`, jak treść stron aplikacji; `inset` — w środku, jak sekcje
   * strony głównej.
   */
  align?: "page" | "inset";
}

const { compact = false, align = "page" } = Astro.props;
const PAGE_GUTTER = "px-4 sm:px-6 lg:px-8";
const support = getSupportContact();
const copy = getSiteFooterCopy(Astro.locals.locale);
const year = new Date().getFullYear();
---

<footer
  class:list={[
    "border-line text-ink-muted border-t text-[13px] leading-6",
    compact ? "py-5" : "py-7",
    align === "page" && PAGE_GUTTER,
  ]}
>
  <div
    class:list={[
      "mx-auto flex max-w-6xl flex-col gap-3 sm:flex-row sm:items-center sm:justify-between",
      align === "inset" && PAGE_GUTTER,
    ]}
  >
    <p class="leading-6">
      <span class="text-ink font-semibold">SafeSpace</span>
      <span aria-hidden="true"> · </span>
      {copy.disclaimer}
    </p>
    <nav aria-label={copy.navAria} class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <a
        href="/privacy"
        class="hover:text-ink focus-visible:ring-brand-ring rounded underline-offset-4 transition-colors hover:underline focus:outline-none focus-visible:ring-2"
      >
        {copy.privacy}
      </a>
      {
        support.mailtoHref ? (
          <a
            href={support.mailtoHref}
            class="hover:text-ink focus-visible:ring-brand-ring rounded underline-offset-4 transition-colors hover:underline focus:outline-none focus-visible:ring-2"
          >
            {copy.contact}
          </a>
        ) : null
      }
      <span class="text-ink-muted">© {year}</span>
    </nav>
  </div>
</footer>
