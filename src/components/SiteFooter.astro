---
import { getSupportContact } from "@/lib/support-contact";

/**
 * Wspólna stopka dla stron „zwykłych” (landing, panel, konto, auth, błędy).
 * Strona rozmowy jej nie ma — tam układ zajmuje cały ekran, a granice i pomoc
 * kryzysowa są już na widoku.
 */
interface Props {
  /** Gęstszy wariant dla kart wyśrodkowanych na ekranie (auth, 404). */
  compact?: boolean;
}

const { compact = false } = Astro.props;
const support = getSupportContact();
const year = new Date().getFullYear();
---

<footer class:list={["border-line text-ink-muted border-t text-sm", compact ? "py-5" : "py-8"]}>
  <div
    class="mx-auto flex max-w-6xl flex-col gap-3 px-4 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8"
  >
    <p class="leading-6">
      <span class="text-ink font-semibold">SafeSpace</span>
      <span aria-hidden="true"> · </span>
      edukacyjna symulacja rozmowy — nie terapia, diagnoza ani pomoc kryzysowa. W nagłym zagrożeniu zadzwoń pod 112.
    </p>
    <nav aria-label="Informacje o serwisie" class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <a
        href="/privacy"
        class="hover:text-brand focus:ring-brand-ring rounded underline-offset-4 transition-colors hover:underline focus:ring-2 focus:outline-none"
      >
        Prywatność i zasady
      </a>
      {
        support.mailtoHref ? (
          <a
            href={support.mailtoHref}
            class="hover:text-brand focus:ring-brand-ring rounded underline-offset-4 transition-colors hover:underline focus:ring-2 focus:outline-none"
          >
            Kontakt
          </a>
        ) : null
      }
      <span class="text-ink-faint">© {year}</span>
    </nav>
  </div>
</footer>
