---
import type { ActiveSessionBadge } from "@/lib/session-flow/active-session-badge";

interface Props {
  /**
   * Rozmowa w toku zastępuje dawną zakładkę „Sesja”: wejście do rozmowy
   * pojawia się w nagłówku tylko wtedy, gdy naprawdę jest dokąd wracać.
   */
  activeSession?: ActiveSessionBadge | null;
}

const { activeSession = null } = Astro.props;
const { user } = Astro.locals;
const activeSessionHref = activeSession
  ? `/dashboard/session?sessionId=${encodeURIComponent(activeSession.sessionId)}`
  : null;
---

<header class="border-line bg-surface/85 sticky top-0 z-30 shrink-0 border-b backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-3 px-4 sm:px-6 lg:px-8">
    <a
      href={user ? "/dashboard" : "/"}
      class="text-ink hover:text-brand-deep focus-visible:ring-brand-ring flex shrink-0 items-center gap-2.5 rounded-md transition-colors focus:outline-none focus-visible:ring-2"
    >
      {/* Łuk: drzwi do pokoju. Znak jest jeden i nie zmienia się z kontekstem. */}
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" class="h-6 w-6">
        <path
          d="M4.5 21.5V12a7.5 7.5 0 0 1 15 0v9.5Z"
          class="fill-brand-soft stroke-brand"
          stroke-width="1.75"
          stroke-linejoin="round"></path>
      </svg>
      <span class="font-serif text-[22px] font-medium tracking-tight">SafeSpace</span>
    </a>

    {
      activeSessionHref ? (
        <a
          href={activeSessionHref}
          class="border-line-accent bg-surface text-brand-deep hover:bg-surface-soft focus-visible:ring-brand-ring flex h-11 min-w-0 items-center gap-2 rounded-full border px-3.5 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2"
        >
          <span aria-hidden="true" class="bg-brand h-2 w-2 shrink-0 rounded-full" />
          <span class="truncate">
            Rozmowa w toku
            {activeSession?.remainingMinutes ? ` · ok. ${activeSession.remainingMinutes} min` : null}
          </span>
        </a>
      ) : null
    }

    <div class="ml-auto flex shrink-0 items-center">
      {
        user ? (
          <details class="group relative" data-account-menu>
            <summary class="border-line-strong bg-surface text-ink-soft hover:bg-surface-soft focus-visible:ring-brand-ring flex h-11 cursor-pointer list-none items-center gap-2 rounded-full border pr-3 pl-4 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2">
              <span>Konto</span>
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-4 w-4 transition-transform group-open:rotate-180"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="border-line-strong bg-surface shadow-rail absolute right-0 z-40 mt-2 w-72 rounded-2xl border p-2">
              <p class="text-ink-muted truncate px-2.5 py-2 text-xs">{user.email}</p>
              <a
                href="/account/security"
                class="text-ink-soft hover:bg-surface-soft focus-visible:ring-brand-ring flex min-h-11 items-center gap-2 rounded-xl px-2.5 py-2 text-sm transition-colors focus:outline-none focus-visible:ring-2"
              >
                Konto
              </a>

              {/*
                Po tę aplikację sięga się najczęściej wieczorem, przy zgaszonym
                świetle. Domyślnie idzie za ustawieniem systemu — te trzy przyciski
                są dla kogoś, kto chce co innego niż reszta telefonu. Wybór jest
                globalny, więc obejmuje też stronę rozmowy, która nie ma nagłówka.
              */}
              <div class="border-line mt-1 border-t px-2.5 pt-2 pb-1">
                <p class="text-ink-muted text-xs" id="theme-switch-label">
                  Wygląd
                </p>
                <div
                  role="group"
                  aria-labelledby="theme-switch-label"
                  class="border-line-strong mt-1.5 flex gap-0.5 rounded-xl border p-0.5"
                  data-theme-switch
                >
                  <button
                    type="button"
                    data-theme-option="system"
                    class="text-ink-soft hover:bg-surface-soft focus-visible:ring-brand-ring aria-pressed:bg-brand-tint aria-pressed:text-brand-deep h-11 flex-1 rounded-[10px] text-xs transition-colors focus:outline-none focus-visible:ring-2 aria-pressed:font-semibold"
                  >
                    System
                  </button>
                  <button
                    type="button"
                    data-theme-option="light"
                    class="text-ink-soft hover:bg-surface-soft focus-visible:ring-brand-ring aria-pressed:bg-brand-tint aria-pressed:text-brand-deep h-11 flex-1 rounded-[10px] text-xs transition-colors focus:outline-none focus-visible:ring-2 aria-pressed:font-semibold"
                  >
                    Jasny
                  </button>
                  <button
                    type="button"
                    data-theme-option="dark"
                    class="text-ink-soft hover:bg-surface-soft focus-visible:ring-brand-ring aria-pressed:bg-brand-tint aria-pressed:text-brand-deep h-11 flex-1 rounded-[10px] text-xs transition-colors focus:outline-none focus-visible:ring-2 aria-pressed:font-semibold"
                  >
                    Wieczorny
                  </button>
                </div>
              </div>
              <form method="POST" action="/api/auth/signout">
                <button
                  type="submit"
                  class="text-ink-soft hover:bg-surface-soft focus-visible:ring-brand-ring flex w-full items-center gap-2 rounded-xl px-2.5 py-2 text-left text-sm transition-colors focus:outline-none focus-visible:ring-2"
                >
                  Wyloguj się
                </button>
              </form>
            </div>
          </details>
        ) : (
          <a
            href="/auth/signin"
            class="border-line-accent text-ink hover:bg-surface-soft focus-visible:ring-brand-ring flex h-11 items-center rounded-full border px-4 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2"
          >
            Zaloguj się
          </a>
        )
      }
    </div>
  </div>
</header>

<script>
  // Menu konta jest zbudowane na <details>, więc działa bez JS.
  // Skrypt dokłada tylko zamykanie kliknięciem obok i Escape.
  const menus = document.querySelectorAll<HTMLDetailsElement>("[data-account-menu]");

  document.addEventListener("click", (event) => {
    for (const menu of menus) {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) {
        menu.open = false;
      }
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") {
      return;
    }

    for (const menu of menus) {
      if (!menu.open) {
        continue;
      }

      menu.open = false;
      // Zamknięte menu zabiera ze sobą element, na którym stał fokus — bez
      // tego ląduje on na <body> i klawiatura zaczyna od początku strony.
      // Wraca więc na przycisk, który menu otworzył.
      menu.querySelector<HTMLElement>("summary")?.focus();
    }
  });

  // Przełącznik wyglądu. „System” usuwa zapisany wybór i oddaje decyzję
  // ustawieniu urządzenia — dlatego trzy stany, nie dwa: bez tego nie da się
  // wrócić do trybu nocnego sterowanego telefonem.
  const THEME_STORAGE_KEY = "safespace-theme";

  function readStoredTheme() {
    try {
      const stored = localStorage.getItem(THEME_STORAGE_KEY);

      return stored === "dark" || stored === "light" ? stored : "system";
    } catch {
      return "system";
    }
  }

  function applyTheme(theme: string) {
    if (theme === "dark" || theme === "light") {
      document.documentElement.dataset.theme = theme;
    } else {
      delete document.documentElement.dataset.theme;
    }
  }

  for (const group of document.querySelectorAll<HTMLElement>("[data-theme-switch]")) {
    const options = group.querySelectorAll<HTMLButtonElement>("[data-theme-option]");

    function markActive(theme: string) {
      for (const option of options) {
        option.setAttribute("aria-pressed", String(option.dataset.themeOption === theme));
      }
    }

    markActive(readStoredTheme());

    for (const option of options) {
      option.addEventListener("click", () => {
        const theme = option.dataset.themeOption ?? "system";

        try {
          if (theme === "system") {
            localStorage.removeItem(THEME_STORAGE_KEY);
          } else {
            localStorage.setItem(THEME_STORAGE_KEY, theme);
          }
        } catch {
          // Zapis może być niedostępny; motyw i tak zadziała do końca wizyty.
        }

        applyTheme(theme);
        markActive(theme);
      });
    }
  }
</script>
