---
interface Props {
  current?: "dashboard" | "session" | "avatar" | "account";
}

const { current } = Astro.props;
const { user } = Astro.locals;

const navItems = [
  { key: "dashboard", href: "/dashboard", label: "Panel" },
  { key: "session", href: "/dashboard/session", label: "Sesja" },
  { key: "avatar", href: "/dashboard/avatar", label: "Awatar" },
] as const;
---

<header class="border-line bg-surface/90 sticky top-0 z-30 shrink-0 border-b backdrop-blur">
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-4 px-4 sm:px-6 lg:px-8">
    <a
      href="/dashboard"
      class="text-brand-deep hover:text-brand focus:ring-brand-ring shrink-0 text-base font-semibold transition-colors focus:ring-2 focus:outline-none"
    >
      SafeSpace
    </a>

    <nav aria-label="Nawigacja główna" class="flex min-w-0 items-center gap-1 overflow-x-auto">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={current === item.key ? "page" : undefined}
            class:list={[
              "focus:ring-brand-ring rounded-lg px-3 py-1.5 text-sm font-medium whitespace-nowrap transition-colors focus:ring-2 focus:outline-none",
              current === item.key
                ? "bg-surface-hover text-brand"
                : "text-ink-muted hover:bg-surface-soft hover:text-brand",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex shrink-0 items-center">
      {
        user ? (
          <details class="group relative" data-account-menu>
            <summary class="border-line text-ink-muted hover:bg-surface-soft focus:ring-brand-ring flex h-9 cursor-pointer list-none items-center gap-2 rounded-lg border px-3 text-sm transition-colors focus:ring-2 focus:outline-none">
              <span class="hidden max-w-40 truncate sm:inline">{user.email}</span>
              <span class="sm:hidden">Konto</span>
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-4 w-4 transition-transform group-open:rotate-180"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="border-line bg-surface shadow-card absolute right-0 z-40 mt-2 w-60 rounded-lg border p-2">
              <p class="text-ink-faint truncate px-2 py-1.5 text-xs sm:hidden">{user.email}</p>
              <a
                href="/account/security"
                class="text-ink-soft hover:bg-surface-soft focus:ring-brand-ring flex items-center gap-2 rounded-md px-2 py-2 text-sm transition-colors focus:ring-2 focus:outline-none"
              >
                Ustaw hasło
              </a>
              <form method="POST" action="/api/auth/signout">
                <button
                  type="submit"
                  class="text-ink-soft hover:bg-surface-soft focus:ring-brand-ring flex w-full items-center gap-2 rounded-md px-2 py-2 text-left text-sm transition-colors focus:ring-2 focus:outline-none"
                >
                  Wyloguj się
                </button>
              </form>
            </div>
          </details>
        ) : (
          <a
            href="/auth/signin"
            class="border-line-accent text-brand hover:bg-surface-hover focus:ring-brand-ring flex h-9 items-center rounded-lg border px-3 text-sm font-medium transition-colors focus:ring-2 focus:outline-none"
          >
            Zaloguj się
          </a>
        )
      }
    </div>
  </div>
</header>

<script>
  // Menu konta jest zbudowane na <details>, więc działa bez JS.
  // Skrypt dokłada tylko zamykanie kliknięciem obok i Escape.
  const menus = document.querySelectorAll<HTMLDetailsElement>("[data-account-menu]");

  document.addEventListener("click", (event) => {
    for (const menu of menus) {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) {
        menu.open = false;
      }
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") {
      return;
    }

    for (const menu of menus) {
      menu.open = false;
    }
  });
</script>
