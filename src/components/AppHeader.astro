---
import LocaleSwitch from "@/components/LocaleSwitch.astro";
import ThemeSwitch from "@/components/ThemeSwitch.astro";
import { getAppHeaderCopy } from "@/components/app-header-copy";
import { isBillingEnabled } from "@/lib/billing/config";
import { getBillingCopy } from "@/lib/billing/copy";
import type { ActiveSessionBadge } from "@/lib/session-flow/active-session-badge";

interface Props {
  /**
   * Rozmowa w toku zastępuje dawną zakładkę „Sesja”: wejście do rozmowy
   * pojawia się w nagłówku tylko wtedy, gdy naprawdę jest dokąd wracać.
   */
  activeSession?: ActiveSessionBadge | null;
  /**
   * Do której krawędzi równać logo i menu. `page` (domyślnie) = kontener
   * treści aplikacji: odstęp poza `max-w-6xl`, jak w panelu, pamięci i wyborze
   * perspektywy. `inset` = odstęp wewnątrz `max-w-6xl`, jak sekcje strony
   * głównej i stopka. Różnica jest widoczna dopiero powyżej ~1200 px.
   */
  align?: "page" | "inset";
}

const { activeSession = null, align = "page" } = Astro.props;
const { user } = Astro.locals;
const copy = getAppHeaderCopy(Astro.locals.locale);
const billingCopy = getBillingCopy(Astro.locals.locale);
// Przy wyłączonych płatnościach strona abonamentu nie sprzeda ani nie otworzy
// portalu — pozycja w menu na każdej stronie prowadziłaby w ślepy zaułek.
// Sprawdzenie to odczyt zmiennej, bez zapytania do bazy przy każdym renderze;
// istniejący abonament przy wyłączonych płatnościach pokazuje strona konta.
const billingEnabled = isBillingEnabled();
const activeSessionHref = activeSession
  ? `/dashboard/session?sessionId=${encodeURIComponent(activeSession.sessionId)}`
  : null;
const PAGE_GUTTER = "px-4 sm:px-6 lg:px-8";
---

<header
  class:list={[
    "border-line bg-surface/85 sticky top-0 z-30 shrink-0 border-b backdrop-blur",
    align === "page" && PAGE_GUTTER,
  ]}
>
  <div class:list={["mx-auto flex h-16 max-w-6xl items-center gap-3", align === "inset" && PAGE_GUTTER]}>
    <a
      href={user ? "/dashboard" : "/"}
      class="text-ink hover:text-brand-deep focus-visible:ring-brand-ring flex shrink-0 items-center gap-2.5 rounded-md transition-colors focus:outline-none focus-visible:ring-2"
    >
      {/* Łuk: drzwi do pokoju. Znak jest jeden i nie zmienia się z kontekstem. */}
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" class="h-6 w-6">
        <path
          d="M4.5 21.5V12a7.5 7.5 0 0 1 15 0v9.5Z"
          class="fill-brand-soft stroke-brand"
          stroke-width="1.75"
          stroke-linejoin="round"></path>
      </svg>
      {/* Korekta optyczna: litery Newsreader są osadzone wyżej niż środek łuku. */}
      <span class="translate-y-0.5 font-serif text-[22px] font-medium tracking-tight">SafeSpace</span>
    </a>

    {
      activeSessionHref ? (
        <a
          href={activeSessionHref}
          class="border-line-accent bg-surface text-brand-deep hover:bg-surface-soft focus-visible:ring-brand-ring flex h-11 min-w-0 items-center gap-2 rounded-full border px-3.5 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2"
        >
          <span aria-hidden="true" class="bg-brand h-2 w-2 shrink-0 rounded-full" />
          <span class="truncate">{copy.activePill(activeSession?.remainingMinutes ?? null)}</span>
        </a>
      ) : null
    }

    <div class="ml-auto flex shrink-0 items-center">
      {
        user ? (
          <details class="group relative" data-account-menu>
            <summary class="border-line-strong bg-surface text-ink-soft hover:bg-surface-soft focus-visible:ring-brand-ring flex h-11 cursor-pointer list-none items-center gap-2 rounded-full border pr-3 pl-4 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2">
              <span>{copy.account}</span>
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-4 w-4 transition-transform group-open:rotate-180"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="border-line-strong bg-surface shadow-rail absolute right-0 z-40 mt-2 max-h-[calc(100dvh-5rem-env(safe-area-inset-bottom))] w-72 max-w-[calc(100vw-3rem)] overflow-y-auto overscroll-contain rounded-2xl border p-2">
              <p class="text-ink-muted truncate px-2.5 py-2 text-xs">{user.email}</p>
              <a
                href="/account/security"
                class="text-ink-soft hover:bg-surface-soft focus-visible:ring-brand-ring flex min-h-11 items-center gap-2 rounded-xl px-2.5 py-2 text-sm transition-colors focus:outline-none focus-visible:ring-2"
              >
                {copy.planSettings}
              </a>
              {billingEnabled ? (
                <a
                  href="/account/billing"
                  class="text-ink-soft hover:bg-surface-soft focus-visible:ring-brand-ring flex min-h-11 items-center gap-2 rounded-xl px-2.5 py-2 text-sm transition-colors focus:outline-none focus-visible:ring-2"
                >
                  {billingCopy.link}
                </a>
              ) : null}

              {/*
                Po tę aplikację sięga się najczęściej wieczorem, przy zgaszonym
                świetle. Domyślnie idzie za ustawieniem systemu — te trzy przyciski
                są dla kogoś, kto chce co innego niż reszta telefonu. Wybór jest
                globalny, więc obejmuje też stronę rozmowy, która nie ma nagłówka.
              */}
              <div class="border-line mt-1 border-t px-2.5 pt-2 pb-1">
                <ThemeSwitch labelId="theme-switch-label" />
              </div>
              {/* Język: ten sam kształt co przełącznik wyglądu, ale natywny formularz — wybór idzie do cookie i na konto. */}
              <div class="border-line mt-1 border-t px-2.5 pt-2 pb-1">
                <LocaleSwitch variant="segmented" />
              </div>
              <form method="POST" action="/api/auth/signout">
                <button
                  type="submit"
                  class="text-ink-soft hover:bg-surface-soft focus-visible:ring-brand-ring flex min-h-11 w-full items-center gap-2 rounded-xl px-2.5 py-2 text-left text-sm transition-colors focus:outline-none focus-visible:ring-2"
                >
                  {copy.signOut}
                </button>
              </form>
            </div>
          </details>
        ) : (
          <div class="flex items-center gap-2">
            {/* Osoba, która trafia na angielski domyślny, musi znaleźć „Polski” bez czytania po angielsku. */}
            <LocaleSwitch />
            <a
              href="/auth/signin"
              class="border-line-accent text-ink hover:bg-surface-soft focus-visible:ring-brand-ring flex h-11 items-center rounded-full border px-4 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2"
            >
              {copy.signIn}
            </a>
          </div>
        )
      }
    </div>
  </div>
</header>

<script>
  // Menu konta jest zbudowane na <details>, więc działa bez JS.
  // Skrypt dokłada tylko zamykanie kliknięciem obok i Escape.
  const menus = document.querySelectorAll<HTMLDetailsElement>("[data-account-menu]");

  document.addEventListener("click", (event) => {
    for (const menu of menus) {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) {
        menu.open = false;
      }
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") {
      return;
    }

    for (const menu of menus) {
      if (!menu.open) {
        continue;
      }

      menu.open = false;
      // Zamknięte menu zabiera ze sobą element, na którym stał fokus — bez
      // tego ląduje on na <body> i klawiatura zaczyna od początku strony.
      // Wraca więc na przycisk, który menu otworzył.
      menu.querySelector<HTMLElement>("summary")?.focus();
    }
  });
</script>
