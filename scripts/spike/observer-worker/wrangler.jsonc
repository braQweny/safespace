{
  // Etap 0 spike (S12/S13): minimalny Worker z Durable Object, który przez sideband
  // obserwuje sesję GPT-Live przez 60 minut, rotując połączenie co 12 minut.
  // Uruchomienie z katalogu repo:
  //   npx wrangler dev --config scripts/spike/observer-worker/wrangler.jsonc --remote
  // (lokalny miniflare nie odwzoruje eviction; liczy się runtime Cloudflare).
  // Sekret: npx wrangler secret put OPENAI_API_KEY --config scripts/spike/observer-worker/wrangler.jsonc
  // albo plik scripts/spike/observer-worker/.dev.vars (ignorowany).
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "safespace-voice-observer-spike",
  "main": "src/index.js",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "OBSERVER", "class_name": "SpikeObserver" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SpikeObserver"] }],
  "vars": {
    "OPENROUTER_SAFETY_MODEL": "openai/gpt-5.6-luna",
    "ROTATION_MS": "720000",
  },
}
