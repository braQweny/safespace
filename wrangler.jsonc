{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "safespace",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["SUPABASE_URL", "SUPABASE_KEY", "OPENROUTER_API_KEY"],
  },
  // Wybór modeli OpenRouter. To NIE są sekrety (`access: "public"` w
  // astro.config.mjs), więc mieszkają tu — wersjonowane i widoczne w review —
  // zamiast w budowanym w CI pliku sekretów, który ich nie przenosił. Bez nich
  // `resolveOpenRouterModel()` spada na `OPENROUTER_DEFAULT_MODEL`
  // (`openai/gpt-4o-mini`), a ten model nie ma endpointu ZDR obsługującego
  // `max_tokens`, więc każda tura rozmowy kończyła się na produkcji 404 →
  // `provider_unavailable` → HTTP 503. Trzymaj w zgodzie z `.env.example`.
  "vars": {
    "OPENROUTER_SAFETY_MODEL": "openai/gpt-5.6-luna",
    "OPENROUTER_SESSION_MODEL": "openai/gpt-5.6-luna",
    "OPENROUTER_SESSION_REASONING_EFFORT": "xhigh",
    "OPENROUTER_SUMMARY_MODEL": "openai/gpt-5.6-luna",
    "OPENROUTER_TRANSCRIPTION_MODEL": "openai/gpt-4o-mini-transcribe",
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
  // Rate limits. Counters are kept per Cloudflare location (approximate, not
  // global) — good enough for cost and abuse protection. The "unsafe" prefix
  // means open-beta API, not danger.
  "unsafe": {
    "bindings": [
      // Per-user cap on AI-backed session endpoints (fail-closed in prod).
      {
        "name": "SESSION_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": {
          "limit": 20,
          "period": 60,
        },
      },
      // Per-IP cap on the credential-handling auth forms (signin, signup,
      // reset/resend, password change). Always fail-open — see
      // `src/lib/rate-limit.ts`.
      {
        "name": "AUTH_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": {
          "limit": 10,
          "period": 60,
        },
      },
    ],
  },
}
