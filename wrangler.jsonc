{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "safespace",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["SUPABASE_URL", "SUPABASE_KEY", "OPENROUTER_API_KEY"],
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
  // Per-user rate limit for AI-backed session endpoints. Counters are kept
  // per Cloudflare location (approximate, not global) — good enough for cost
  // and abuse protection. The "unsafe" prefix means open-beta API, not danger.
  "unsafe": {
    "bindings": [
      {
        "name": "SESSION_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": {
          "limit": 20,
          "period": 60,
        },
      },
    ],
  },
}
