{
  "name": "safespace",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check:astro": "astro check",
    "format": "prettier --write .",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db": "node --test tests/database/*.test.mjs",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "dev:billing": "node scripts/start-billing-sandbox.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.2",
    "@astrojs/react": "6.0.6",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@openrouter/sdk": "1.3.8",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "pg": "8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stripe": "22.6.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/config-helpers": "^0.7.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.14.5",
    "husky": "9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.117.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "wrangler": "4.135.0"
  },
  "lint-staged": {
    "*.{ts,tsx,astro,js,mjs,cjs}": [
      "eslint --fix"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
